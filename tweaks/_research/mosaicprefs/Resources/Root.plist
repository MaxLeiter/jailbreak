<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>items</key>
	<array>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>footerText</key>
			<string>Mosaic turns iPad apps into macOS-style floating windows. Tap a dock or home-screen app to open it as a window; drag to move, snap to the edges, or use the green dot for fullscreen. Long-press an app → Open as App to launch it normally.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>Enabled</string>
			<key>key</key>
			<string>enabled</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>com.max.mosaic</string>
			<key>PostNotification</key>
			<string>com.max.mosaic.changed</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>footerText</key>
			<string>Changes apply immediately. If something looks off, toggle off and on, or respring.</string>
		</dict>
	</array>
	<key>title</key>
	<string>Mosaic</string>
</dict>
</plist>
