<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>application-identifier</key>
	<string>com.max.taskmanager</string>

	<!-- Run without a sandbox data container and as a platform binary so the app
	     can (a) enumerate every live process via sysctl(KERN_PROC_ALL) and read
	     per-process memory/CPU via proc_pidinfo across the whole system, (b) map
	     pids to installed apps via LSApplicationWorkspace, and (c) kill() other
	     `mobile`-owned processes. This is the same entitlement shape KioskMode
	     already validated on-device for private, sandbox-sensitive APIs. -->
	<key>com.apple.private.security.container-required</key>
	<false/>
	<key>platform-application</key>
	<true/>
	<key>com.apple.private.security.no-container</key>
	<true/>
</dict>
</plist>
