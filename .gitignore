# Local secrets / machine-specific config
device.env
.env
.env.*
!.env.example
!.env.*.example

# JavaScript dependencies and build outputs
node_modules/
*/node_modules/
**/node_modules/
.next/
dist/

# Theos build artifacts
.theos/
*/.theos/
**/.theos/

# Built packages
packages/
repo/debs/
!x11/packages/
!x11/packages/**
*.deb

# Derived APT index artifacts, regenerated (and signed) at publish time from
# repo/Packages. Tracking them is what made every parallel branch conflict:
# Release embeds a `Date:` line so it changes on every regeneration, and
# .gz / .gpg / InRelease are binary. repo/Packages itself stays tracked -- it is
# the manifest, and it merges structurally via .gitattributes.
#
# These live HERE and not in repo/.gitignore on purpose. repo/.gitignore is
# copied into the Vercel upload and applied by the CLI, so listing them there
# deleted them from the deployed repo and broke apt everywhere (2026-07-29).
# The root .gitignore is never inside the uploaded directory.
repo/Packages.gz
repo/Release
repo/Release.gpg
repo/InRelease
repo/Packages.pv
repo/Packages.sha

# Generated Xios outputs
x11/artifacts/
x11/linux-build/stage/
x11/wayland/out/
x11/packages/*/out/
x11/packages/**/out/
x11/apps/iosc-desktop/package-session-*.log
x11/apps/iosc-shell/design/.sf/
x11/docs/*.zip

# Vendored upstream source tarballs — the build recipes re-fetch these from
# upstream via DOWNLOAD_FILES/EXTRACT_TAR (URLs live in x11/linux-build/recipes/*.mk).
# Curated header subdirs (dbus-headers/, libei-1.3.0/src/) stay tracked as build
# inputs; only the archive blobs are ignored.
x11/linux-build/src-tarballs/*.tar
x11/linux-build/src-tarballs/*.tar.gz
x11/linux-build/src-tarballs/*.tar.xz

# Vercel local project state
.vercel/

# Xcode / Apple local output
DerivedData/
apps/*/build-release-check/
xcuserdata/
*.xcuserstate
*.dSYM/
*.app.dSYM/
*.ipa
*.mobileprovision
*.p12

# Editor / OS cruft
.DS_Store
*.swp
.repo-venv/

# Apple TV pairing credentials (local only)
apps/KitchenHub/Sources/Services/AppleTV/AppleTVConfig.swift

# Python bytecode
__pycache__/
*.pyc
.vercel
