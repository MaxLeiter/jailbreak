{
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/./:path*", "destination": "/:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    },
    {
      "source": "/debs/(.*)",
      "headers": [
        { "key": "Content-Type", "value": "application/x-debian-package" }
      ]
    }
  ]
}
