{
  "git": {
    "deploymentEnabled": false
  },
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/profiles/rootful/debs/:path*",
      "destination": "https://j7lqamqsi8q1vmg4.public.blob.vercel-storage.com/profiles/rootful/debs/:path*",
      "permanent": false
    },
    {
      "source": "/debs/:path*",
      "destination": "https://j7lqamqsi8q1vmg4.public.blob.vercel-storage.com/debs/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/./:path*", "destination": "/:path*" }
  ],
  "headers": [
    {
      "source": "/(Packages|Packages.gz|Release|InRelease|Release.gpg)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/debs/(.*)",
      "headers": [
        { "key": "Content-Type", "value": "application/x-debian-package" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/profiles/rootful/debs/(.*)",
      "headers": [
        { "key": "Content-Type", "value": "application/x-debian-package" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(icons|banners)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=2592000" }
      ]
    },
    {
      "source": "/depictions/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=86400" }
      ]
    }
  ]
}
