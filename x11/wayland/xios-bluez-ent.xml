<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for xios-bluez-stub. The org.bluez bridge reaches iOS Bluetooth via the
  private BluetoothManager.framework, which XPCs to /usr/sbin/bluetoothd. bluetoothd's XPC
  peer-check gates real adapter/device data behind com.apple.bluetooth.system: verified
  on device (A10, iOS 17.6.1) that WITHOUT it BluetoothManager reports powered=0/available=0
  and enumerates nothing, and WITH it alone the shim lists the real paired devices
  (AirPods / Xbox controller) and reads Powered=true. This is the minimal unlock; the daemon
  is otherwise unsandboxed root and needs no other special entitlement.
-->
<plist version="1.0">
<dict>
  <key>com.apple.bluetooth.system</key>
  <true/>
</dict>
</plist>
