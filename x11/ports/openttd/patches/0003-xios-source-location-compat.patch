diff --git a/src/3rdparty/xios/source_location.hpp b/src/3rdparty/xios/source_location.hpp
new file mode 100644
--- /dev/null
+++ b/src/3rdparty/xios/source_location.hpp
@@ -0,0 +1,40 @@
+/*
+ * C++20 source_location compatibility for the libc++ version in the Xios
+ * target sysroot. Clang evaluates these builtins at the call site when they
+ * are used as default arguments.
+ */
+
+#ifndef OPENTTD_XIOS_SOURCE_LOCATION_HPP
+#define OPENTTD_XIOS_SOURCE_LOCATION_HPP
+
+namespace std {
+
+class source_location {
+public:
+	static constexpr source_location current(
+			const char *file = __builtin_FILE(),
+			const char *function = __builtin_FUNCTION(),
+			unsigned line = __builtin_LINE()) noexcept
+	{
+		return source_location(file, function, line);
+	}
+
+	constexpr const char *file_name() const noexcept { return this->file; }
+	constexpr const char *function_name() const noexcept { return this->function; }
+	constexpr unsigned line() const noexcept { return this->line_number; }
+	constexpr unsigned column() const noexcept { return 0; }
+
+private:
+	constexpr source_location(const char *file, const char *function, unsigned line) noexcept :
+			file(file), function(function), line_number(line)
+	{
+	}
+
+	const char *file = "";
+	const char *function = "";
+	unsigned line_number = 0;
+};
+
+} // namespace std
+
+#endif
