--- a/Source/ThirdParty/ANGLE/CMakeLists.txt
+++ b/Source/ThirdParty/ANGLE/CMakeLists.txt
@@ -1,7 +1,11 @@
 set_property(DIRECTORY . PROPERTY FOLDER "ANGLE")
 
 if (APPLE)
-    set(is_mac TRUE)
+    # The Procursus cross toolchain reports an iOS target as APPLE/Darwin.
+    # Keep the vendored subset out of its macOS-only source list and let the
+    # GTK platform file select the available iOS/POSIX implementations.
+    set(is_ios TRUE)
+    set(is_mac FALSE)
 elseif (WIN32)
     set(is_win TRUE)
     set(angle_enable_d3d9 TRUE)
--- a/Source/ThirdParty/ANGLE/PlatformGTK.cmake
+++ b/Source/ThirdParty/ANGLE/PlatformGTK.cmake
@@ -6,6 +6,14 @@ list(APPEND ANGLE_DEFINITIONS ANGLE_PLATFORM_LINUX EGL_NO_PLATFORM_SPECIFIC_TYPES
 include(linux.cmake)
 
 if (USE_OPENGL)
+    if (is_ios)
+        list(APPEND ANGLE_SOURCES
+            ${angle_translator_glsl_apple_sources}
+            src/common/system_utils_apple.cpp
+            src/common/system_utils_ios.cpp
+            src/common/system_utils_posix.cpp)
+    endif ()
+
     # Enable GLSL compiler output.
     list(APPEND ANGLE_DEFINITIONS ANGLE_ENABLE_GLSL)
 endif ()
--- a/Source/ThirdParty/ANGLE/GL.cmake
+++ b/Source/ThirdParty/ANGLE/GL.cmake
@@ -114,7 +114,7 @@ if(is_linux OR is_chromeos)
     )
 endif()
 
-if(is_android OR is_linux OR is_chromeos)
+if(is_android OR is_linux OR is_chromeos OR (is_ios AND PORT STREQUAL "GTK"))
     list(APPEND gl_backend_sources
         "src/libANGLE/renderer/gl/egl/ContextEGL.cpp"
         "src/libANGLE/renderer/gl/egl/ContextEGL.h"
