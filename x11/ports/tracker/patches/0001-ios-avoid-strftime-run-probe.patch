Subject: [PATCH] tracker: avoid strftime run probe when cross building

Tracker probes the libc 4-digit-year strftime modifier by running a target
binary, which is not possible in the iOS cross build. Use the Darwin answer
directly.

diff -ruN -U0 --exclude=*.bak a/meson.build b/meson.build
--- a/meson.build	2024-05-02 06:11:35
+++ b/meson.build	2026-07-05 00:28:19
@@ -212,31 +212 @@
-result = cc.run('''
-  #define _TIME_BITS 64
-  #define _GNU_SOURCE
-  #include <stdio.h>
-  #include <string.h>
-  #include <time.h>
-
-  int main (int argc, char *argv[]) {
-    char *modifiers[] = { "%Y", "%C%y", "%4Y", "%2C%y", NULL };
-    time_t timestamp = -58979923200; /* 0101-01-01T01:01:01Z */
-    char buf[100];
-    struct tm tm;
-    int i;
-    gmtime_r (&timestamp, &tm);
-    for (i = 0; modifiers[i]; i++) {
-      strftime (buf, sizeof buf, modifiers[i], &tm);
-      if (strcmp (buf, "0101") == 0) {
-        printf ("%s", modifiers[i]);
-        return 0;
-      }
-    }
-    return -1;
-  }
-  ''',
-  name: 'strftime 4-digit year modifier')
-
-if not result.compiled() or result.returncode() != 0
-  error('Libc implementation has broken 4-digit years implementation.')
-else
-  year_modifier = result.stdout()
-endif
+year_modifier = '%Y'
