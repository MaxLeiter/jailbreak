Subject: [PATCH] swayimg: add iOS libc++ format compatibility

The iPhoneOS SDK libc++ headers available in the Procursus cross image provide
the basic C++20 headers but not std::format, nor std::hash for
std::filesystem::path. Upstream swayimg uses <format> throughout the core
sources and uses filesystem paths as unordered-map keys, so add source-root
headers named "format" and "filesystem" that the existing -I.. include path
resolves before SDK headers.

The same compiler rejects a few newer C++20 conveniences used upstream:
parenthesized aggregate initialization, reference capture of structured-binding
names, and aggregate emplace construction. Keep the source changes narrow so
the patch can be dropped when the cross toolchain catches up.

diff -ruN -x build -x '*.done' -x .xios_patch_series.sha256 a/filesystem b/filesystem
--- a/filesystem	1970-01-01 00:00:00.000000000 +0000
+++ b/filesystem	2026-07-07 00:18:36.422371013 +0000
@@ -0,0 +1,16 @@
+#pragma once
+
+#include_next <filesystem>
+
+#include <functional>
+#include <string>
+
+namespace std {
+template <>
+struct hash<std::filesystem::path> {
+    size_t operator()(const std::filesystem::path& path) const noexcept
+    {
+        return std::hash<std::string> {}(path.string());
+    }
+};
+} // namespace std
diff -ruN -x build -x '*.done' -x .xios_patch_series.sha256 a/format b/format
--- a/format	1970-01-01 00:00:00.000000000 +0000
+++ b/format	2026-07-07 00:18:36.422371013 +0000
@@ -0,0 +1,37 @@
+#pragma once
+
+#ifndef FMT_HEADER_ONLY
+#define FMT_HEADER_ONLY 1
+#endif
+#include <fmt/format.h>
+
+#include <string>
+#include <utility>
+
+namespace std {
+template <typename... Args>
+using format_string = const char*;
+
+template <typename... Args>
+auto make_format_args(Args&&... args)
+{
+    return fmt::make_format_args(std::forward<Args>(args)...);
+}
+
+inline std::string vformat(const char* fmt_str, fmt::format_args args)
+{
+    return fmt::vformat(fmt_str, args);
+}
+
+template <typename... Args>
+std::string format(const char* fmt_str, Args&&... args)
+{
+    return fmt::format(fmt_str, std::forward<Args>(args)...);
+}
+
+template <typename... Args>
+std::string format(const std::string& fmt_str, Args&&... args)
+{
+    return fmt::format(fmt_str, std::forward<Args>(args)...);
+}
+} // namespace std
