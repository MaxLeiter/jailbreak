Subject: [PATCH] mutter: keep iOS cross-build deps optional

libei/libeis are only used when remote desktop is enabled, which this iOS
build disables. Mutter also references sd_pid_get_user_unit() in a Wayland path
even when libsystemd is disabled, so guard that use and keep the no-logind X11
policy fallback.

diff -ruN -U0 --exclude=*.bak a/meson.build b/meson.build
--- a/meson.build	2024-03-16 06:43:07
+++ b/meson.build	2026-07-05 00:35:56
@@ -132,2 +132,2 @@
-libeis_dep = dependency('libeis-1.0', version: libei_req)
-libei_dep = dependency('libei-1.0', version: libei_req)
+libeis_dep = dependency('libeis-1.0', version: libei_req, required: false)
+libei_dep = dependency('libei-1.0', version: libei_req, required: false)
diff -ruN -U0 --exclude=*.bak a/src/core/meta-context-main.c b/src/core/meta-context-main.c
--- a/src/core/meta-context-main.c	2024-03-16 06:43:07
+++ b/src/core/meta-context-main.c	2026-07-05 00:35:56
@@ -350,2 +349,0 @@
-      else if (sd_pid_get_user_unit (0, &unit) < 0)
-        return META_X11_DISPLAY_POLICY_MANDATORY;
@@ -353 +351,11 @@
-        return META_X11_DISPLAY_POLICY_ON_DEMAND;
+        {
+#ifdef HAVE_LIBSYSTEMD
+          if (sd_pid_get_user_unit (0, &unit) < 0)
+            return META_X11_DISPLAY_POLICY_MANDATORY;
+          else
+            return META_X11_DISPLAY_POLICY_ON_DEMAND;
+#else
+          (void) unit;
+          return META_X11_DISPLAY_POLICY_MANDATORY;
+#endif
+        }
