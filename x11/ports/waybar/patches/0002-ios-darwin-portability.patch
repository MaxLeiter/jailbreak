@@ -18,6 +18,31 @@ extern std::list<pid_t> reap;
 
 namespace waybar::util::command {
 
+inline int pipe_cloexec(int fd[2]) {
+#if defined(__APPLE__)
+  if (pipe(fd) != 0) {
+    return -1;
+  }
+  for (int i = 0; i < 2; ++i) {
+    int flags = fcntl(fd[i], F_GETFD);
+    if (flags == -1 || fcntl(fd[i], F_SETFD, flags | FD_CLOEXEC) == -1) {
+      int saved_errno = errno;
+      ::close(fd[0]);
+      ::close(fd[1]);
+      errno = saved_errno;
+      return -1;
+    }
+  }
+  return 0;
+#else
+  return pipe2(fd, O_CLOEXEC);
+#endif
+}
+
+inline int exit_status(int stat) {
+  return WIFEXITED(stat) ? WEXITSTATUS(stat) : -1;
+}
+
 struct res {
   int exit_code;
   std::string out;
@@ -73,7 +97,7 @@ inline FILE* open(const std::string& cmd, int& pid, const std::string& output_na
   // Open the pipe with the close-on-exec flag set, so it will not be inherited
   // by any other subprocesses launched by other threads (which could result in
   // the pipe staying open after this child dies, causing us to hang when trying
   // to read from it)
-  if (pipe2(fd, O_CLOEXEC) != 0) {
+  if (pipe_cloexec(fd) != 0) {
     spdlog::error("Unable to pipe fd");
     return nullptr;
   }
@@ -125,14 +149,14 @@ inline struct res exec(const std::string& cmd, const std::string& output_name) {
   if (!fp) return {-1, ""};
   auto output = command::read(fp);
   auto stat = command::close(fp, pid);
-  return {WEXITSTATUS(stat), output};
+  return {exit_status(stat), output};
 }
 
 inline struct res execNoRead(const std::string& cmd) {
   int pid;
   auto fp = command::open(cmd, pid, "");
   if (!fp) return {-1, ""};
   auto stat = command::close(fp, pid);
-  return {WEXITSTATUS(stat), ""};
+  return {exit_status(stat), ""};
 }
 
