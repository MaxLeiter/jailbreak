Subject: [PATCH] waybar: prune Linux-bound modules for iOS

Keep the initial iOS Waybar build focused on clock and custom modules, and
avoid compiling compositor integrations or Linux service modules that require
runtime infrastructure not yet available in Xios.

diff -ruN -U0 a/meson.build b/meson.build
--- a/meson.build	2026-02-06 12:15:03
+++ b/meson.build	2026-07-06 15:44:53
@@ -164,2 +163,0 @@
-    'src/AIconLabel.cpp',
-    'src/AAppIconLabel.cpp',
@@ -167,7 +164,0 @@
-    'src/modules/disk.cpp',
-    'src/modules/idle_inhibitor.cpp',
-    'src/modules/image.cpp',
-    'src/modules/load.cpp',
-    'src/modules/temperature.cpp',
-    'src/modules/user.cpp',
-    'src/ASlider.cpp',
@@ -254,19 +244,0 @@
-if true
-    add_project_arguments('-DHAVE_SWAY', language: 'cpp')
-    src_files += files(
-        'src/modules/sway/ipc/client.cpp',
-        'src/modules/sway/bar.cpp',
-        'src/modules/sway/mode.cpp',
-        'src/modules/sway/language.cpp',
-        'src/modules/sway/window.cpp',
-        'src/modules/sway/workspaces.cpp',
-        'src/modules/sway/scratchpad.cpp'
-    )
