diff -ruN gnome-shell-46.0/subprojects/extensions-app/subprojects/shew/src/meson.build gnome-shell-46.0.eds/subprojects/extensions-app/subprojects/shew/src/meson.build
--- gnome-shell-46.0/subprojects/extensions-app/subprojects/shew/src/meson.build	2024-03-15 17:56:52
