         creds.gid = getgid();
 
-#elif defined(__FreeBSD__)
+#elif defined(__FreeBSD__)
 #define SOCKET_CRED_OPTION SCM_CREDS
         struct cmsgcred creds = { 0 };
 #else
@@ -159,6 +166,7 @@
                 return errno == EAGAIN ? 0 : -errno;
