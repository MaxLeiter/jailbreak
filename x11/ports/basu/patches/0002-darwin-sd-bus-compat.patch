+        if (k < 0)
+                return errno == EAGAIN ? 0 : -errno;
+        b->send_null_byte = false;
+        return 1;
+#else
 #if defined(__linux__)
 #define SOCKET_CRED_OPTION SCM_CREDENTIALS
         struct ucred creds;
@@ -126,7 +133,7 @@
