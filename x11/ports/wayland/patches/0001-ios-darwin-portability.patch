Subject: [PATCH] wayland: add Darwin portability for iOS

Pull epoll-shim on Darwin, add iOS fallbacks for SOCK_CLOEXEC and
MSG_CMSG_CLOEXEC, use LOCAL_PEERCRED/LOCAL_PEERPID for socket credentials, and
provide struct itimerspec for epoll-shim's timerfd declarations.

diff -ruN -U0 --exclude=*.bak a/meson.build b/meson.build
--- a/meson.build	2024-08-24 08:43:55
+++ b/meson.build	2026-07-05 00:33:14
@@ -19 +19 @@
-if host_machine.system() not in ['freebsd', 'openbsd']
+if host_machine.system() not in ['freebsd', 'openbsd', 'darwin']
diff -ruN -U0 --exclude=*.bak a/src/event-loop.c b/src/event-loop.c
--- a/src/event-loop.c	2024-08-24 08:43:55
+++ b/src/event-loop.c	2026-07-05 00:33:14
@@ -40,0 +41,8 @@
+#ifdef __APPLE__
+/* iOS <time.h> lacks struct itimerspec (no POSIX timers); epoll-shim only
+ * forward-declares it. Provide the definition for timerfd_settime/gettime. */
+struct itimerspec {
+	struct timespec it_interval;
+	struct timespec it_value;
+};
+#endif
diff -ruN -U0 --exclude=*.bak a/src/wayland-os.c b/src/wayland-os.c
--- a/src/wayland-os.c	2024-08-24 08:43:55
+++ b/src/wayland-os.c	2026-07-05 00:33:14
@@ -44,0 +45,5 @@
+#ifndef SOCK_CLOEXEC
+/* Darwin/iOS has no SOCK_CLOEXEC; fall through to set_cloexec_or_close(). */
+#define SOCK_CLOEXEC 0
+#endif
+
@@ -78 +83 @@
-	fd = wl_socket(domain, type | SOCK_CLOEXEC, protocol);
+	fd = set_cloexec_or_close(wl_socket(domain, type | SOCK_CLOEXEC, protocol));
@@ -127,0 +133,19 @@
+#elif defined(__APPLE__)
+int
+wl_os_socket_peercred(int sockfd, uid_t *uid, gid_t *gid, pid_t *pid)
+{
+	struct xucred ucred;
+	socklen_t len = sizeof(ucred);
+	if (getsockopt(sockfd, SOL_LOCAL, LOCAL_PEERCRED, &ucred, &len) < 0 ||
+	    ucred.cr_version != XUCRED_VERSION)
+		return -1;
+	*uid = ucred.cr_uid;
+	*gid = ucred.cr_groups[0];
+	pid_t epid = 0;
+	socklen_t elen = sizeof(epid);
+	if (getsockopt(sockfd, SOL_LOCAL, LOCAL_PEERPID, &epid, &elen) == 0)
+		*pid = epid;
+	else
+		*pid = 0;
+	return 0;
+}
@@ -181 +205 @@
-#if HAVE_BROKEN_MSG_CMSG_CLOEXEC
+#if HAVE_BROKEN_MSG_CMSG_CLOEXEC || !defined(MSG_CMSG_CLOEXEC)
