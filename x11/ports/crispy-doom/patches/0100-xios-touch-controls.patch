+#ifndef __I_TOUCH__
+#define __I_TOUCH__
+
+#include "SDL.h"
+
+#include "doomtype.h"
+
+// What the game is currently showing, as far as touch input cares.
+
+typedef enum
+{
+    // Playing a level: move stick, drag to turn, action buttons.
+    TOUCH_SCREEN_LEVEL,
+
+    // Menus, title screen, demos: tap = menu forward, swipe = arrows.
+    TOUCH_SCREEN_MENU,
+
+    // A yes/no message prompt: tap = confirm.
+    TOUCH_SCREEN_PROMPT,
+
+    // Intermission and finale: tap = use, which skips ahead.
+    TOUCH_SCREEN_ADVANCE
+} touch_screen_t;
+
+typedef touch_screen_t (*touch_screen_callback_t)(void);
+
+// Called by the game before I_InitGraphics(). Enables the touch controls
+// unless the XIOS_TOUCH_CONTROLS environment variable is "0". Without this
+// call (or with the variable set to "0") every other function here is a
+// no-op.
+
+void I_Touch_Init(touch_screen_callback_t callback);
+
+// True if the touch controls are enabled.
+
+boolean I_Touch_Enabled(void);
+
+// Called right after SDL video init. SDL starts with text input on, and
+// on a touch device that raises the on-screen keyboard: turn it off until
+// the game asks for typed text with I_StartTextInput().
+
+void I_Touch_InitVideo(void);
+
+// Called for every SDL event before it is dispatched. Returns true if the
+// event was consumed by the touch controls and must not be processed
+// further.
+
+boolean I_Touch_FilterEvent(const SDL_Event *sdlevent);
+
+// Called once per tic, after the event queue has been read.
+
+void I_Touch_UpdateTic(void);
+
+// Drop relative mouse motion that the compositor emulated from a touch.
+// Called before reading the mouse.
+
+void I_Touch_DiscardMouseMotion(void);
+
+// Draw the overlay. Called after the frame has been rendered and before
+// it is presented.
+
+void I_Touch_Draw(SDL_Renderer *renderer);
+
+#endif
