+// [xios] Tell the on-screen touch controls what is on screen.
+
+extern int messageToPrint;
+extern boolean messageNeedsInput;
+
+static touch_screen_t D_TouchScreenCallback(void)
+{
+    if (menuactive)
+    {
+        return (messageToPrint && messageNeedsInput) ?
+               TOUCH_SCREEN_PROMPT : TOUCH_SCREEN_MENU;
+    }
+
+    if (demoplayback)
+    {
+        return TOUCH_SCREEN_MENU;
+    }
+
+    switch (gamestate)
+    {
+        case GS_LEVEL:
+            return TOUCH_SCREEN_LEVEL;
+
+        case GS_INTERMISSION:
+        case GS_FINALE:
+            return TOUCH_SCREEN_ADVANCE;
+
+        default:
+            return TOUCH_SCREEN_MENU;
