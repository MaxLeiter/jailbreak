diff --git a/BUILD.gn b/BUILD.gn
index c831acc0c0..6710feb58a 100644
--- a/BUILD.gn
+++ b/BUILD.gn
@@ -1619,7 +1619,9 @@ template("libEGL_shared_template") {
 }
 
 libEGL_shared_template("libEGL") {
-  defines = [ "ANGLE_DISPATCH_LIBRARY=\"${_angle_glesv2_library_name}\"" ]
+  # X11-on-iOS: dispatch to the plain dylib (resolved under /var/jb/lib/angle by the
+  # patched OpenSystemLibrary path logic) rather than an iOS .framework bundle.
+  defines = [ "ANGLE_DISPATCH_LIBRARY=\"${_angle_glesv2_library_name}.dylib\"" ]
   output_name = "libEGL"
