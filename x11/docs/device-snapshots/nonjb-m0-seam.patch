 extern char *display;
 
+/* Relocation root for the on-disk prefix. Deliberate local twin of xios_root()
+ * in x11/wayland/xios_paths.h: this file is ALSO copied verbatim into the Xorg
+ * hw/vfb/ tree by linux-build/build.sh, whose build container does not mount
+ * wayland/ and cannot see that header — so the seam can't be shared here. Same
+ * contract: XIOS_ROOT env override, else "/var/jb" (JB behavior unchanged). */
+static const char *xios_root_local(void)
+{
+    const char *r = getenv("XIOS_ROOT");
+    return (r && *r) ? r : "/var/jb";
+}
