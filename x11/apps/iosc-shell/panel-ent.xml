<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  iosc shell client entitlements. wl_shm layer-shell clients draw on the CPU and
  hands wl_shm buffers to iosc (iosc does the GPU compositing), so it needs NO
  AGX/IOGPU/IOSurface IOKit entitlements (cf. kgx's cairo->wl_shm path, which
  needs no GPU entitlement). It only needs to reach the Wayland/runtime sockets,
  app metadata, icons, and launched apps for either rootless (/var/jb) or rootful
  (/) jailbreak layouts.
-->
<plist version="1.0">
<dict>
    <key>get-task-allow</key>
    <true/>
    <key>com.apple.private.security.no-container</key>
    <true/>
    <key>com.apple.private.skip-library-validation</key>
    <true/>
    <key>com.apple.security.exception.files.absolute-path.read-write</key>
    <array>
        <string>/tmp/</string>
        <string>/private/tmp/</string>
        <string>/usr/share/</string>
        <string>/usr/local/share/</string>
        <string>/var/jb/tmp/</string>
        <string>/private/var/jb/tmp/</string>
        <string>/var/jb/usr/share/</string>
        <string>/private/var/jb/usr/share/</string>
    </array>
</dict>
</plist>
