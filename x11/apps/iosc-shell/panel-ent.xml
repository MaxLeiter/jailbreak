<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  ioscpanel entitlements. A wl_shm layer-shell client: it draws on the CPU and
  hands wl_shm buffers to iosc (iosc does the GPU compositing), so it needs NO
  AGX/IOGPU/IOSurface IOKit entitlements (cf. kgx's cairo->wl_shm path, which
  needs no GPU entitlement). It only needs to reach the wayland + (optional)
  ioscd sockets under /var/jb/tmp and to fork/exec launched apps.
-->
<plist version="1.0">
<dict>
    <key>get-task-allow</key>
    <true/>
    <key>com.apple.private.security.no-container</key>
    <true/>
    <key>com.apple.private.skip-library-validation</key>
    <true/>
    <key>com.apple.security.exception.files.absolute-path.read-write</key>
    <array>
        <string>/var/jb/tmp/</string>
        <string>/var/jb/usr/share/applications/</string>
    </array>
</dict>
</plist>
