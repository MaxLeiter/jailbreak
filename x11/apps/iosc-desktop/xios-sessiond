#!/usr/bin/env bash
# xios-sessiond — root daemon that turns an in-app session pick into a launched
# desktop. It watches the SAME channel the Xios app already uses for display
# profiles, /var/jb/tmp/xios-request.json, for a session request:
#
#     { "action": "session", "preset": "iosc|mutter|gnome|app|stop",
#       "app": "<name>",            # only when preset == app
#       "width": 1080, "height": 1440, "dpi": 176,  # optional next-session display
#       "created_at": "<iso8601>" } # changes every write -> retriggers
#
# and runs the matching preset via the shared library (xios_session_run). Requests
# with any other "action" (e.g. the existing "display-profile") are ignored, so this
# coexists with the display-profile consumer on the same file.
#
# Runs as root from launchd (com.max.xios-sessiond.plist), OUTSIDE the app sandbox,
# so it can spawn the compositor + Wayland clients the way the run-*.sh scripts do
# (the Xios app itself, as `mobile` in the sandbox, cannot).
#
# It primes itself with the file's current contents at startup and only acts on a
# CHANGE, so a stale request left over from a previous boot never auto-launches.
set -u

LIB="${XIOS_SESSION_LIB:-/var/jb/libexec/xios-session/xios-session-lib.sh}"
[ -r "$LIB" ] || LIB="$(cd "$(dirname "$0")" 2>/dev/null && pwd)/xios-session-lib.sh"
# shellcheck source=/dev/null
. "$LIB"

REQ="${XS_TMP:-/var/jb/tmp}/xios-request.json"
POLL="${XIOS_SESSIOND_POLL:-1}"   # seconds between polls

# sed JSON scalar reader (string or number), same style as xios-server.sh.
json_get() {  # json_get <key> <file>
    sed -n "s/.*\"$1\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p; s/.*\"$1\"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p" "$2" 2>/dev/null | head -n 1
}

xs_log "xios-sessiond up; watching $REQ (poll ${POLL}s)"

# Prime: remember what's there now so we don't process a pre-existing request.
last="$(cat "$REQ" 2>/dev/null || true)"

while :; do
    sleep "$POLL"
    cur="$(cat "$REQ" 2>/dev/null || true)"
    [ "$cur" = "$last" ] && continue     # unchanged
    last="$cur"
    [ -n "$cur" ] || continue

    action="$(json_get action "$REQ")"
    [ "$action" = "session" ] || continue   # not ours (e.g. display-profile)

    preset="$(json_get preset "$REQ")"
    app="$(json_get app "$REQ")"
    width="$(json_get width "$REQ")"
    height="$(json_get height "$REQ")"
    dpi="$(json_get dpi "$REQ")"
    xs_log "request: preset=${preset:-?} ${app:+app=$app}${width:+ width=$width}${height:+ height=$height}${dpi:+ dpi=$dpi}"
    # Serve it. Run in a subshell so a preset failure can't kill the watcher.
    (
        case "$width:$height" in
            *[!0-9:]*|:|*:|:*) ;;
            *)
                if [ -n "$width" ] && [ -n "$height" ]; then
                    export IOSC_LOGICAL="${width}x${height}"
                    export XIOS_SESSION_WIDTH="$width"
                    export XIOS_SESSION_HEIGHT="$height"
                fi ;;
        esac
        case "$dpi" in
            ''|*[!0-9]*) ;;
            *) export XIOS_SESSION_DPI="$dpi" ;;
        esac
        xios_session_run "$preset" "$app"
    ) || xs_log "preset '$preset' returned non-zero"
done
