<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchDaemon for xios-sessiond, the desktop-session launcher watcher. Runs on the
  DEVICE as root, started by launchd. It watches /var/jb/tmp/xios-request.json for a
  {"action":"session",...} request (written by the Xios app's session picker or the
  `xios-session -d` CLI) and brings up the chosen flavor (iosc / mutter / gnome / app)
  via the shared library, tearing down the previous session first.

  Install (see install-xios-session.sh):
    cp com.max.xios-sessiond.plist /var/jb/Library/LaunchDaemons/
    launchctl bootstrap system /var/jb/Library/LaunchDaemons/com.max.xios-sessiond.plist
  KeepAlive restarts it if it exits; RunAtLoad starts it at boot.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.max.xios-sessiond</string>

    <key>ProgramArguments</key>
    <array>
        <string>/var/jb/usr/bin/bash</string>
        <string>/var/jb/libexec/xios-session/xios-sessiond</string>
    </array>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/var/jb/tmp/xios-sessiond.log</string>
    <key>StandardErrorPath</key>
    <string>/var/jb/tmp/xios-sessiond.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/var/jb/usr/bin:/var/jb/usr/sbin:/var/jb/bin:/var/jb/sbin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
