#!/bin/sh
# Start the optional Xios AT-SPI bridge components inside the current session bus.

SELF_DIR="$(CDPATH= cd -- "$(dirname "$0")" 2>/dev/null && pwd)"
if [ "${XS_JB+x}" != x ]; then
    case "$SELF_DIR/" in
        /var/jb/*) XS_JB=/var/jb ;;
        *)         XS_JB= ;;
    esac
fi
XS_SUBPREFIX=${XS_SUBPREFIX:-/usr}
if [ -n "$XS_JB" ]; then
    XIOS_PREFIX=${XIOS_PREFIX:-$XS_JB$XS_SUBPREFIX}
    XIOS_TMP=${XIOS_TMP:-$XS_JB/tmp}
else
    XIOS_PREFIX=${XIOS_PREFIX:-$XS_SUBPREFIX}
    XIOS_TMP=${XIOS_TMP:-${XIOS_RUNTIME_TMP:-/var/tmp}}
fi

LOG=${XIOS_ATSPI_LOG:-$XIOS_TMP/xios-atspi.log}
A11Y_LOG=${XIOS_A11YD_LOG:-$XIOS_TMP/xios-a11yd.log}
A11Y_SOCK=${XIOS_A11Y_SOCK:-$XIOS_TMP/xios-a11y.sock}

if [ -x "$XIOS_PREFIX/libexec/at-spi-bus-launcher" ]; then
    "$XIOS_PREFIX/libexec/at-spi-bus-launcher" --launch-immediately >>"$LOG" 2>&1 &
elif command -v at-spi-bus-launcher >/dev/null 2>&1; then
    at-spi-bus-launcher --launch-immediately >>"$LOG" 2>&1 &
fi

if command -v gdbus >/dev/null 2>&1; then
    for _ in 1 2 3 4 5; do
        gdbus call --session --dest org.a11y.Bus --object-path /org/a11y/bus \
            --method org.freedesktop.DBus.Properties.Set \
            org.a11y.Status IsEnabled '<true>' >>"$LOG" 2>&1 && break
        sleep 0.2
    done
    gdbus call --session --dest org.a11y.Bus --object-path /org/a11y/bus \
        --method org.freedesktop.DBus.Properties.Set \
        org.a11y.Status ScreenReaderEnabled '<true>' >>"$LOG" 2>&1
fi

# One xios-a11yd per socket. The socket alone proves nothing: it outlives a
# crashed or jetsammed daemon, and the old "skip when the socket exists" test
# then never started one again. Trust the pid recorded beside the socket while
# it is still xios-a11yd; a socket with no pid file is left to whoever made it
# only while some xios-a11yd is running.
a11yd_running() {
    _pid=$(cat "$A11Y_SOCK.pid" 2>/dev/null)
    case "$_pid" in
        ""|*[!0-9]*) ;;
        *) kill -0 "$_pid" 2>/dev/null &&
               ps -p "$_pid" -o command= 2>/dev/null | grep -q xios-a11yd && return 0 ;;
    esac
    [ -S "$A11Y_SOCK" ] && [ ! -f "$A11Y_SOCK.pid" ] &&
        ps ax -o command= 2>/dev/null | grep -v grep | grep -q xios-a11yd
}

if command -v xios-a11yd >/dev/null 2>&1 && ! a11yd_running; then
    xios-a11yd >>"$A11Y_LOG" 2>&1 &
    echo "$!" >"$A11Y_SOCK.pid" 2>/dev/null || true
fi

exit 0
