#!/usr/bin/env bash
# xios-session — on-device CLI to pick a desktop session/flavor on the iPad.
#
# This is the terminal trigger that replaces "the team lead SSHes a run-*.sh
# script each time". Run it as root on the device (or over SSH):
#
#   xios-session iosc            # lightweight iosc desktop (works today)
#   xios-session mutter          # raw Mutter --wayland (flat stage)
#   xios-session gnome           # gnome-shell --wayland (EXPERIMENTAL)
#   xios-session kde             # KWin + desktop plasmashell nested on iosc (EXPERIMENTAL)
#   xios-session kde-mobile      # KWin + Plasma Mobile shell package (EXPERIMENTAL)
#   xios-session kde-nano        # KWin + Plasma Nano shell package (EXPERIMENTAL)
#   xios-session app kgx         # launch a client against the running compositor
#   xios-session app gnome-text-editor
#   xios-session resize          # restart active desktop with XIOS_SESSION_WIDTH/HEIGHT/DPI
#   xios-session stop            # tear everything down, back to SpringBoard
#   xios-session status          # print the last session status
#
# Optional for ioscd requests:
#   XIOS_SESSION_WIDTH=1080 XIOS_SESSION_HEIGHT=1440 XIOS_SESSION_DPI=176 xios-session -d kde-mobile
#
# By default it acts IMMEDIATELY (calls the shared library — no daemon needed, so
# it works over a bare SSH shell). Pass -d/--via-daemon to instead send the same
# ioscd socket request the in-app picker uses.
#
# GOTCHA (b): the iPad screen must be AWAKE + UNLOCKED, or the Xios Metal app is
# suspended by FrontBoard and presents a black frame. Unlock the device first.
set -u

XS_SELF_DIR="$(cd "$(dirname "$0")" 2>/dev/null && pwd)"
if [ "${XS_JB+x}" != x ]; then
    case "$XS_SELF_DIR/" in
        /var/jb/*) XS_JB=/var/jb ;;
        *)         XS_JB= ;;
    esac
    export XS_JB
fi
if [ "${XS_TMP+x}" != x ]; then
    if [ -n "$XS_JB" ]; then
        XS_TMP="$XS_JB/tmp"
    else
        XS_TMP="${XIOS_RUNTIME_TMP:-/var/tmp}"
    fi
    export XS_TMP
fi
if [ "${XS_LIBEXEC_DIR+x}" != x ]; then
    XS_LIBEXEC_DIR="$XS_JB/libexec/xios-session"
    export XS_LIBEXEC_DIR
fi

LIB_CANDIDATES=(
    "${XIOS_SESSION_LIB:-}"
    "$XS_LIBEXEC_DIR/xios-session-lib.sh"
    "$XS_SELF_DIR/xios-session-lib.sh"
)
LIB=""
for c in "${LIB_CANDIDATES[@]}"; do
    [ -n "$c" ] && [ -r "$c" ] && { LIB="$c"; break; }
done
[ -n "$LIB" ] || { echo "xios-session: cannot find xios-session-lib.sh" >&2; exit 1; }

PRESCAN=()
while [ "$#" -gt 0 ]; do
    case "$1" in
        --slot)
            [ "$#" -ge 2 ] || { echo "xios-session: --slot needs a name" >&2; exit 2; }
            export XIOS_SESSION_SLOT="$2"
            shift 2 ;;
        --slot=*)
            export XIOS_SESSION_SLOT="${1#--slot=}"
            shift ;;
        *)
            PRESCAN+=("$1")
            shift ;;
    esac
done
set -- "${PRESCAN[@]:-}"
# shellcheck source=/dev/null
. "$LIB"

IOSCD_SOCK="${XS_TMP}/ioscd.sock"
VIA_DAEMON=0

usage() { xios_session_run help; exit "${1:-2}"; }

# option scan (-d/--via-daemon; --slot is pre-scanned before loading the lib)
ARGS=()
for a in "$@"; do
    case "$a" in
        -d|--via-daemon) VIA_DAEMON=1 ;;
        -h|--help)       usage 0 ;;
        *)               ARGS+=("$a") ;;
    esac
done
set -- "${ARGS[@]:-}"

PRESET="${1:-}"
[ -n "$PRESET" ] || usage 2

case "$PRESET" in
    status)
        cat "${XS_STATUS:-$XS_TMP/xios-session-status.json}" 2>/dev/null \
            || echo '{"state":"unknown","message":"no status yet"}'
        exit 0 ;;
esac

send_ioscd_session() {
    local preset="$1" app="${2:-}" line ack
    [ -S "$IOSCD_SOCK" ] || return 1
    line=$(printf 'SESSION\t%s\t%s\t%s\t%s\t%s\t%s\n' \
        "$preset" "$app" "${XIOS_SESSION_WIDTH:-}" "${XIOS_SESSION_HEIGHT:-}" "${XIOS_SESSION_DPI:-}" "${XIOS_SESSION_SLOT:-}")
    ack=""
    if command -v nc >/dev/null 2>&1; then
        ack="$(printf '%s' "$line" | nc -U "$IOSCD_SOCK" 2>/dev/null | head -n 1 || true)"
    fi
    if [ "$ack" != "SESSION_STARTED" ] && command -v socat >/dev/null 2>&1; then
        ack="$(printf '%s' "$line" | socat -t 3 - "UNIX-CONNECT:$IOSCD_SOCK" 2>/dev/null | head -n 1 || true)"
    fi
    if [ "$ack" != "SESSION_STARTED" ] && command -v python3 >/dev/null 2>&1; then
        ack="$(IOSCD_SOCK="$IOSCD_SOCK" XIOS_SESSION_LINE="$line" python3 - <<'PY' 2>/dev/null || true
import os
import socket
import sys

sock_path = os.environ["IOSCD_SOCK"]
line = os.environ["XIOS_SESSION_LINE"].encode()

with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
    sock.settimeout(3)
    sock.connect(sock_path)
    sock.sendall(line)
    sock.shutdown(socket.SHUT_WR)
    data = sock.recv(256)

sys.stdout.write(data.decode(errors="replace").splitlines()[0] if data else "")
PY
)"
    fi
    [ "$ack" = "SESSION_STARTED" ]
}

if [ "$VIA_DAEMON" = 1 ]; then
    # Mirror the in-app picker: send the request to ioscd.sock.
    APP="${2:-}"
    if send_ioscd_session "$PRESET" "$APP"; then
        echo "xios-session: sent session request preset=$PRESET${APP:+ app=$APP} -> $IOSCD_SOCK"
    else
        echo "xios-session: ioscd SESSION request failed at $IOSCD_SOCK" >&2
        exit 1
    fi
    exit 0
fi

# Immediate path: do the work now.
xios_session_run "$PRESET" "${2:-}"
