<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Shared entitlements for spawned helpers: WebContent, RequestServer, ImageDecoder,
         WebWorker, and Compositor. AMFI checks entitlements PER BINARY, so each helper
         needs its own signature even though it is spawned by the UI app. -->

    <!-- Load fakesigned /var/jb dylibs (each helper statically links the engine but still
         pulls leaf dylibs: icu78, harfbuzz, freetype, curl+openssl, sqlite3, ...). -->
    <key>platform-application</key>
    <true/>
    <key>com.apple.private.amfi.can-allow-non-platform</key>
    <true/>
    <key>com.apple.private.skip-library-validation</key>
    <true/>

    <!-- Keeps the child spawnable and debuggable by the parent. -->
    <key>get-task-allow</key>
    <true/>

    <!-- Deliberately NOT granted: task_for_pid-allow and com.apple.system-task-ports.
         Those let a process obtain other processes' task ports, i.e. read and write another
         process's memory. That is a privilege-escalation primitive, and handing it to
         processes whose whole job is parsing untrusted web content is the worst place for it.
         Nothing needs them here: a helper sends its OWN task port during the Mach bootstrap
         handshake, which requires no entitlement, and the iOS path discards the received port
         anyway (`(void)request.task_port` in LibWebView/Application.cpp; set_process_mach_port
         is macOS-only). Removal was device-validated by re-signing the shipped helpers with
         this set and loading a page: WebContent, RequestServer, ImageDecoder and Compositor
         all still work. See docs/ladybird-sandbox-confinement.md for why kernel-profile
         confinement is not available and entitlement minimisation is the lever instead. -->

    <!-- The Compositor uses IOSurface for the shared front/back buffers. GPU-linked builds
         also need AGX/IOGPU for ANGLE/Metal/WebGL. Still one set for all spawned helpers,
         because the .app flavor signs Compositor with this file too
         (packages/ladybird-app/resign-ladybird-app-deb.sh), so narrowing the GPU classes to
         Compositor alone needs per-helper entitlement files first. -->
    <!-- FIXME: split per helper. WebContent and ImageDecoder need neither the GPU classes nor
         write access; RequestServer is the only one that genuinely writes (HTTP disk cache and
         alt-svc cache). Blocked on per-helper files because this one is shared by both
         flavors' signing paths. -->

    <key>com.apple.security.iokit-user-client-class</key>
    <array>
        <string>AGXDeviceUserClient</string>
        <string>IOGPUDeviceUserClient</string>
        <string>IOSurfaceRootUserClient</string>
        <string>IOSurfaceSendRight</string>
        <string>IOSurfaceAcceleratorClient</string>
    </array>

    <!-- FS closure the helpers touch: engine resources (/var/jb/share/Lagom or the in-bundle
         copy), TLS certs, the IPC socket dir, cookie/cache stores. -->
    <key>com.apple.security.exception.files.absolute-path.read-write</key>
    <array>
        <string>/var/jb/</string>
        <string>/private/var/jb/</string>
        <string>/tmp/</string>
        <string>/private/tmp/</string>
    </array>

</dict>
</plist>
