#!/bin/sh
# Ensure the writable dir where the X server's xkbcomp helper drops compiled
# keymaps exists. The Xvfb binary has this path baked in (/var/jb/var/lib/xkb);
# without it, XKB init fails and the server exits on startup.
set -e
case "$1" in
  configure|install|"")
    mkdir -p /var/jb/var/lib/xkb
    ;;
esac
exit 0
