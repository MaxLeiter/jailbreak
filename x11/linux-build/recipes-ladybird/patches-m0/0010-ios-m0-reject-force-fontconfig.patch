Subject: [PATCH] ios-m0: reject --force-fontconfig on iOS instead of aborting

There is no fontconfig anywhere in the iOS build: USE_FONTCONFIG is gated
`if (NOT APPLE)` in Meta/CMake/check_for_dependencies.cmake, and the Apple Skia
build ships no fontconfig SkFontMgr. --force-fontconfig therefore cannot select a
different font path here -- all it does is rename the PathFontProvider to
"FontConfig", which made 0008's CoreText installation get skipped, leaving
font_manager null and tripping VERIFY(font_manager) in TypefaceSkia.cpp.

Two changes:

  * TypefaceSkia installs the CoreText font manager unconditionally on iOS, so no
    provider name can leave it null.
  * The three places that parse --force-fontconfig (the UI process and the
    WebContent/Compositor services) reject the flag on iOS with a message saying
    why, instead of accepting an option that cannot do anything.
--- a/Libraries/LibGfx/Font/TypefaceSkia.cpp
+++ b/Libraries/LibGfx/Font/TypefaceSkia.cpp
@@ -85,11 +85,17 @@ static SkFontMgr& font_manager()
 {
     auto& font_manager = skia_font_manager();
     if (!font_manager) {
-#if defined(AK_OS_MACOS) || defined(AK_OS_IOS)
+#if defined(AK_OS_IOS)
+        // The Apple Skia build has no fontconfig SkFontMgr, so CoreText is the only font manager
+        // available on iOS -- install it unconditionally. --force-fontconfig only renames the
+        // PathFontProvider to "FontConfig" (it cannot change how fonts load here), so honouring
+        // that name would leave font_manager null and trip the VERIFY below.
+        font_manager = SkFontMgr_New_CoreText(nullptr);
+#elif defined(AK_OS_MACOS)
         if (Gfx::FontDatabase::the().system_font_provider_name() != "FontConfig"sv) {
             font_manager = SkFontMgr_New_CoreText(nullptr);
         }
 #endif
 #if defined(AK_OS_ANDROID)
         font_manager = SkFontMgr_New_Android(nullptr);
 #elif defined(AK_OS_WINDOWS)
--- a/Libraries/LibWebView/Application.cpp
+++ b/Libraries/LibWebView/Application.cpp
@@ -361,7 +361,17 @@ ErrorOr<void> Application::initialize(Main::Arguments const& arguments)
 
     create_platform_arguments(args_parser);
     args_parser.parse(m_arguments);
 
+#ifdef AK_OS_IOS
+    // Reject rather than ignore: this build has no fontconfig at all, so the flag can only
+    // mislead. Caught in the UI process so it never reaches the helpers either.
+    if (force_fontconfig) {
+        warnln("--force-fontconfig is not supported on iOS: this build has no fontconfig font provider.");
+        warnln("Fonts load from the bundled resource://fonts set through the CoreText font manager.");
+        return Error::from_string_literal("--force-fontconfig is not supported on iOS");
+    }
+#endif
+
     // Our persisted SQL storage assumes it runs in a singleton process. If we have multiple UI processes accessing
     // the same underlying database, one of them is likely to fail.
     if (force_new_process)
--- a/Services/WebContent/main.cpp
+++ b/Services/WebContent/main.cpp
@@ -212,9 +212,15 @@ ErrorOr<int> ladybird_main(Main::Arguments arguments)
         URL::set_file_scheme_urls_have_tuple_origins();
 
     auto& font_provider = static_cast<Gfx::PathFontProvider&>(Gfx::FontDatabase::the().install_system_font_provider(make<Gfx::PathFontProvider>()));
     if (force_fontconfig) {
+#ifdef AK_OS_IOS
+        // No fontconfig in this build; see Libraries/LibGfx/Font/TypefaceSkia.cpp.
+        warnln("WebContent: --force-fontconfig is not supported on iOS: this build has no fontconfig font provider.");
+        return Error::from_string_literal("--force-fontconfig is not supported on iOS");
+#else
         font_provider.set_name_but_fixme_should_create_custom_system_font_provider("FontConfig"_string);
+#endif
     }
     font_provider.load_all_fonts_from_uri("resource://fonts"sv);
 
     WebContent::PageClient::set_is_headless(is_headless);
--- a/Services/Compositor/main.cpp
+++ b/Services/Compositor/main.cpp
@@ -4,6 +4,7 @@
  * SPDX-License-Identifier: BSD-2-Clause
  */
 
+#include <AK/Format.h>
 #include <Compositor/ConnectionFromClient.h>
 #include <Compositor/Sandbox.h>
 #include <LibCore/ArgsParser.h>
@@ -41,8 +42,15 @@ ErrorOr<int> ladybird_main(Main::Arguments arguments)
 
     WebView::platform_init();
     auto& font_provider = static_cast<Gfx::PathFontProvider&>(Gfx::FontDatabase::the().install_system_font_provider(make<Gfx::PathFontProvider>()));
-    if (force_fontconfig)
+    if (force_fontconfig) {
+#ifdef AK_OS_IOS
+        // No fontconfig in this build; see Libraries/LibGfx/Font/TypefaceSkia.cpp.
+        warnln("Compositor: --force-fontconfig is not supported on iOS: this build has no fontconfig font provider.");
+        return Error::from_string_literal("--force-fontconfig is not supported on iOS");
+#else
         font_provider.set_name_but_fixme_should_create_custom_system_font_provider("FontConfig"_string);
+#endif
+    }
     for (auto const& path : TRY(Gfx::FontDatabase::font_directories()))
         font_provider.load_all_fonts_from_uri(TRY(String::formatted("file://{}", path)));
     font_provider.load_all_fonts_from_uri("resource://fonts"sv);
