diff --git a/Libraries/LibJS/CMakeLists.txt b/Libraries/LibJS/CMakeLists.txt
index 0e11e6d867..6efe64847f 100644
--- a/Libraries/LibJS/CMakeLists.txt
+++ b/Libraries/LibJS/CMakeLists.txt
@@ -364,12 +364,22 @@ if (DEFINED FLAP_ARCH)
     # NB: GenerateLayout.cpp does not depend on Op.h since opcode field
     # offsets are computed from interpreter.flap by flapc directly.
 
-    add_custom_command(
-        OUTPUT "${INTERPRETER_LAYOUT_FILE}"
-        COMMAND "$<TARGET_FILE:generate_interpreter_layout>" > "${INTERPRETER_LAYOUT_FILE}"
-        DEPENDS generate_interpreter_layout
-        COMMENT "Generating JS interpreter layout"
-    )
+    if (DEFINED ENV{LB_HOST_GENERATE_INTERPRETER_LAYOUT})
+        # iOS cross build: the target-built tool cannot run on the build host, so the driver provides a
+        # native arm64 build of the same source (host and target are both LP64 arm64: identical offsets).
+        add_custom_command(
+            OUTPUT "${INTERPRETER_LAYOUT_FILE}"
+            COMMAND "$ENV{LB_HOST_GENERATE_INTERPRETER_LAYOUT}" > "${INTERPRETER_LAYOUT_FILE}"
+            COMMENT "Generating JS interpreter layout (host tool)"
+        )
+    else()
+        add_custom_command(
+            OUTPUT "${INTERPRETER_LAYOUT_FILE}"
+            COMMAND "$<TARGET_FILE:generate_interpreter_layout>" > "${INTERPRETER_LAYOUT_FILE}"
+            DEPENDS generate_interpreter_layout
+            COMMENT "Generating JS interpreter layout"
+        )
+    endif()
 
     build_rust_binary(
         MANIFEST_PATH Flap/Cargo.toml
@@ -389,7 +399,8 @@ if (DEFINED FLAP_ARCH)
     # Interpreter assertions guard memory safety invariants, so keep them in every build type.
     set(FLAP_EXTRA_FLAGS "--enable-assertions")
     # All Apple Silicon chips are ARMv8.5+ which includes FEAT_JSCVT.
-    if ("${FLAP_ARCH}" STREQUAL "aarch64" AND APPLE)
+    # iOS: the A10 is ARMv8.1 without FEAT_JSCVT, so ToInt32 must stay software (no --has-jscvt).
+    if ("${FLAP_ARCH}" STREQUAL "aarch64" AND APPLE AND NOT IOS)
         list(APPEND FLAP_EXTRA_FLAGS "--has-jscvt")
     endif()
 
diff --git a/Meta/CMake/rust_crate.cmake b/Meta/CMake/rust_crate.cmake
index c6efdc78d7..4c15a39df0 100644
--- a/Meta/CMake/rust_crate.cmake
+++ b/Meta/CMake/rust_crate.cmake
@@ -128,6 +128,16 @@ function(build_rust_binary)
         set(ARG_OUTPUT_NAME "${ARG_BINARY_NAME}")
     endif()
 
+    # iOS cross build: build-time generators must run on the build host, so the driver can supply natively
+    # built copies in LB_HOST_RUST_BIN_DIR. Use those instead of cross-compiling a binary we cannot execute.
+    if (DEFINED ENV{LB_HOST_RUST_BIN_DIR} AND EXISTS "$ENV{LB_HOST_RUST_BIN_DIR}/${ARG_BINARY_NAME}")
+        add_custom_target(${ARG_BINARY_NAME}-build)
+        if (ARG_OUTPUT_PATH_VAR)
+            set(${ARG_OUTPUT_PATH_VAR} "$ENV{LB_HOST_RUST_BIN_DIR}/${ARG_BINARY_NAME}" PARENT_SCOPE)
+        endif()
+        return()
+    endif()
+
     _rust_crate_common_setup(
         MANIFEST_PATH "${ARG_MANIFEST_PATH}"
         CRATE_NAME ${ARG_CRATE_NAME}
