Subject: [PATCH] ios-app: gate WebGL traces and avoid fatal FBO traps

Keep the iOS WebGL bring-up diagnostics available, but make them opt-in via
LADYBIRD_WEBGL_TRACE or /var/jb/tmp/ladybird-webgl-trace so regular app runs do
not append verbose logs under /var/jb/tmp.

The ANGLE-backed iOS path should also fail WebGL canvas allocation without
killing the Compositor helper if a framebuffer shape unexpectedly becomes
unsupported on-device.

--- a/Services/Compositor/CanvasHost.cpp
+++ b/Services/Compositor/CanvasHost.cpp
@@ -14,6 +14,7 @@
 #if defined(AK_OS_IOS)
 #    include <stdarg.h>
 #    include <stdio.h>
+#    include <stdlib.h>
 #endif
 
 namespace Compositor {
@@ -21,6 +22,24 @@ namespace Compositor {
 #if defined(AK_OS_IOS)
+static bool lb_webgl_trace_enabled()
+{
+    static bool enabled = [] {
+        auto const* env = getenv("LADYBIRD_WEBGL_TRACE");
+        if (env && env[0] != '\0' && env[0] != '0')
+            return true;
+        auto* flag = fopen("/var/jb/tmp/ladybird-webgl-trace", "r");
+        if (!flag)
+            return false;
+        fclose(flag);
+        return true;
+    }();
+    return enabled;
+}
+
 static void lb_webgl_trace(char const* format, ...)
 {
+    if (!lb_webgl_trace_enabled())
+        return;
+
     auto* file = fopen("/var/jb/tmp/ladybird-webgl.log", "a");
     if (!file)
         return;
--- a/Services/Compositor/OpenGLContext.cpp
+++ b/Services/Compositor/OpenGLContext.cpp
@@ -34,6 +34,7 @@ extern "C" {
 #if defined(AK_OS_IOS)
 #    include <stdarg.h>
 #    include <stdio.h>
+#    include <stdlib.h>
 #endif
 
 // Enable WebGL if we're on macOS and can use Metal, if Linux can use ANGLE's
@@ -47,8 +48,26 @@ namespace Compositor {
 using namespace Web::WebGL;
 
 #if defined(AK_OS_IOS)
+static bool lb_webgl_trace_enabled()
+{
+    static bool enabled = [] {
+        auto const* env = getenv("LADYBIRD_WEBGL_TRACE");
+        if (env && env[0] != '\0' && env[0] != '0')
+            return true;
+        auto* flag = fopen("/var/jb/tmp/ladybird-webgl-trace", "r");
+        if (!flag)
+            return false;
+        fclose(flag);
+        return true;
+    }();
+    return enabled;
+}
+
 static void lb_webgl_trace(char const* format, ...)
 {
+    if (!lb_webgl_trace_enabled())
+        return;
+
     auto* file = fopen("/var/jb/tmp/ladybird-webgl.log", "a");
     if (!file)
         return;
@@ -403,9 +422,15 @@ void OpenGLContext::allocate_painting_surface_if_needed()
         m_impl->framebuffer, framebuffer_binding, m_impl->color_buffer, texture_binding, m_impl->depth_buffer, renderbuffer_binding, eglGetCurrentContext(), m_impl->surface, glGetError());
 
     auto framebuffer_status = glCheckFramebufferStatus(GL_FRAMEBUFFER);
-    if (framebuffer_status != GL_FRAMEBUFFER_COMPLETE)
+    if (framebuffer_status != GL_FRAMEBUFFER_COMPLETE) {
         lb_webgl_trace("framebuffer incomplete status=0x%x gl_error=0x%x depth=%d stencil=%d", framebuffer_status, glGetError(), m_drawing_buffer_options.depth ? 1 : 0, m_drawing_buffer_options.stencil ? 1 : 0);
-    VERIFY(framebuffer_status == GL_FRAMEBUFFER_COMPLETE);
+#if defined(AK_OS_IOS)
+        lb_webgl_trace("framebuffer incomplete; leaving WebGL context without a drawing buffer");
+        return;
+#else
+        VERIFY(framebuffer_status == GL_FRAMEBUFFER_COMPLETE);
+#endif
+    }
 #endif
 }
 
