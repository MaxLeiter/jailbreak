Subject: [PATCH] ios-app: enable ANGLE WebGL path on iOS

Enable the iOS app to use the real ANGLE/Metal WebGL path, including
CPU-backed WebGL readback surfaces for the non-Skia app compositor path and
device-side tracing for EGL/GLES bring-up failures.

diff --git a/Services/Compositor/CanvasHost.cpp b/Services/Compositor/CanvasHost.cpp
index c919b2f972..dc102e11d3 100644
--- a/Services/Compositor/CanvasHost.cpp
+++ b/Services/Compositor/CanvasHost.cpp
@@ -12,8 +12,31 @@
 #include <LibGfx/SkiaBackendContext.h>
 #include <LibWeb/Painting/CanvasSurfaceRegistry.h>

+#if defined(AK_OS_IOS)
+#    include <stdarg.h>
+#    include <stdio.h>
+#endif
+
 namespace Compositor {

+#if defined(AK_OS_IOS)
+static void lb_webgl_trace(char const* format, ...)
+{
+    auto* file = fopen("/var/jb/tmp/ladybird-webgl.log", "a");
+    if (!file)
+        return;
+
+    va_list args;
+    va_start(args, format);
+    vfprintf(file, format, args);
+    va_end(args);
+    fputc('\n', file);
+    fclose(file);
+}
+#else
+static void lb_webgl_trace(char const*, ...) { }
+#endif
+
 CanvasHost::CanvasHost(RefPtr<Gfx::SkiaBackendContext> skia_backend_context, Web::Painting::CanvasSurfaceRegistry& canvas_surface_registry)
     : m_skia_backend_context(move(skia_backend_context))
     , m_canvas_surface_registry(canvas_surface_registry)
@@ -93,13 +116,24 @@ Optional<Web::Painting::CanvasId> CanvasHost::create_2d_context(Gfx::IntSize siz

 CanvasHost::CreateWebGLContextResult CanvasHost::create_webgl_context(Web::WebGL::WebGLVersion version, Gfx::IntSize size, bool depth, bool stencil, bool antialias)
 {
+    lb_webgl_trace("CanvasHost::create_webgl_context version=%d size=%dx%d depth=%d stencil=%d antialias=%d skia=%d",
+        version == Web::WebGL::WebGLVersion::WebGL1 ? 1 : 2,
+        size.width(), size.height(),
+        depth ? 1 : 0,
+        stencil ? 1 : 0,
+        antialias ? 1 : 0,
+        m_skia_backend_context ? 1 : 0);
+
     auto context = HostWebGLContext::create(m_skia_backend_context, version, { .depth = depth, .stencil = stencil, .antialias = antialias }, size);
-    if (!context)
+    if (!context) {
+        lb_webgl_trace("CanvasHost::create_webgl_context failed");
         return {};
+    }

     auto canvas_id = m_canvas_surface_registry.allocate_canvas_id();
     auto supported_extensions = context->gl_context().get_supported_opengl_extensions();
     m_contexts.set(canvas_id, context.release_nonnull());
+    lb_webgl_trace("CanvasHost::create_webgl_context success extensions=%zu", supported_extensions.size());
     return { .success = true, .canvas_id = canvas_id, .supported_extensions = move(supported_extensions) };
 }

