+// reserved. The region is reserved twice its size to align its base, so keep it at 1 GiB.
+static constexpr size_t HEAP_REGION_SIZE = 1ull * GiB;
 #elif AK_IS_ARCH_AARCH64() && !defined(AK_OS_MACOS)
 // Some AArch64 systems provide only 39 or 42 bits of user virtual address
