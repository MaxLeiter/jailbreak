+/*
+ * iOS app GPU build: Ladybird's generated WebGL dispatcher references ANGLE/OES/EXT
+ * entry point names, but the staged GLES dylib exports the equivalent ES3 core names.
+ * Keep this as a narrow adapter layer so the Compositor links against real EGL/GLES
+ * instead of the diagnostic CPU build's trap stubs.
+ */
+
+#define GL_GLEXT_PROTOTYPES 1
+#include <GLES3/gl3.h>
+#include <GLES2/gl2ext.h>
+#include <GLES2/gl2ext_angle.h>
+
+extern "C" {
+
+static void mark_written(GLsizei* length, GLsizei buf_size)
+{
+    if (length)
+        *length = buf_size > 0 ? buf_size : 0;
+}
+
+void GL_APIENTRY glBindVertexArrayOES(GLuint array)
+{
+    glBindVertexArray(array);
+}
+
+void GL_APIENTRY glDeleteVertexArraysOES(GLsizei n, GLuint const* arrays)
+{
+    glDeleteVertexArrays(n, arrays);
+}
+
+void GL_APIENTRY glGenVertexArraysOES(GLsizei n, GLuint* arrays)
+{
+    glGenVertexArrays(n, arrays);
+}
+
+GLboolean GL_APIENTRY glIsVertexArrayOES(GLuint array)
+{
+    return glIsVertexArray(array);
+}
+
+void GL_APIENTRY glDrawArraysInstancedANGLE(GLenum mode, GLint first, GLsizei count, GLsizei primcount)
+{
+    glDrawArraysInstanced(mode, first, count, primcount);
+}
+
+void GL_APIENTRY glDrawElementsInstancedANGLE(GLenum mode, GLsizei count, GLenum type, void const* indices, GLsizei primcount)
+{
+    glDrawElementsInstanced(mode, count, type, indices, primcount);
+}
+
+void GL_APIENTRY glVertexAttribDivisorANGLE(GLuint index, GLuint divisor)
+{
+    glVertexAttribDivisor(index, divisor);
+}
+
+void GL_APIENTRY glDrawBuffersEXT(GLsizei n, GLenum const* bufs)
+{
+    glDrawBuffers(n, bufs);
+}
+
+void GL_APIENTRY glRequestExtensionANGLE(GLchar const*)
+{
+}
+
+void GL_APIENTRY glCompressedTexImage2DRobustANGLE(GLenum target, GLint level, GLenum internalformat, GLsizei width, GLsizei height, GLint border, GLsizei image_size, GLsizei, void const* data)
+{
+    glCompressedTexImage2D(target, level, internalformat, width, height, border, image_size, data);
+}
+
+void GL_APIENTRY glCompressedTexImage3DRobustANGLE(GLenum target, GLint level, GLenum internalformat, GLsizei width, GLsizei height, GLsizei depth, GLint border, GLsizei image_size, GLsizei, void const* data)
+{
+    glCompressedTexImage3D(target, level, internalformat, width, height, depth, border, image_size, data);
+}
+
+void GL_APIENTRY glCompressedTexSubImage2DRobustANGLE(GLenum target, GLint level, GLint xoffset, GLint yoffset, GLsizei width, GLsizei height, GLenum format, GLsizei image_size, GLsizei, void const* data)
+{
+    glCompressedTexSubImage2D(target, level, xoffset, yoffset, width, height, format, image_size, data);
+}
+
+void GL_APIENTRY glCompressedTexSubImage3DRobustANGLE(GLenum target, GLint level, GLint xoffset, GLint yoffset, GLint zoffset, GLsizei width, GLsizei height, GLsizei depth, GLenum format, GLsizei image_size, GLsizei, void const* data)
+{
+    glCompressedTexSubImage3D(target, level, xoffset, yoffset, zoffset, width, height, depth, format, image_size, data);
+}
+
+void GL_APIENTRY glTexImage2DRobustANGLE(GLenum target, GLint level, GLint internalformat, GLsizei width, GLsizei height, GLint border, GLenum format, GLenum type, GLsizei, void const* pixels)
+{
+    glTexImage2D(target, level, internalformat, width, height, border, format, type, pixels);
+}
+
+void GL_APIENTRY glTexImage3DRobustANGLE(GLenum target, GLint level, GLint internalformat, GLsizei width, GLsizei height, GLsizei depth, GLint border, GLenum format, GLenum type, GLsizei, void const* pixels)
+{
+    glTexImage3D(target, level, internalformat, width, height, depth, border, format, type, pixels);
+}
+
+void GL_APIENTRY glTexSubImage2DRobustANGLE(GLenum target, GLint level, GLint xoffset, GLint yoffset, GLsizei width, GLsizei height, GLenum format, GLenum type, GLsizei, void const* pixels)
+{
+    glTexSubImage2D(target, level, xoffset, yoffset, width, height, format, type, pixels);
+}
+
+void GL_APIENTRY glTexSubImage3DRobustANGLE(GLenum target, GLint level, GLint xoffset, GLint yoffset, GLint zoffset, GLsizei width, GLsizei height, GLsizei depth, GLenum format, GLenum type, GLsizei, void const* pixels)
+{
+    glTexSubImage3D(target, level, xoffset, yoffset, zoffset, width, height, depth, format, type, pixels);
+}
+
+void GL_APIENTRY glReadPixelsRobustANGLE(GLint x, GLint y, GLsizei width, GLsizei height, GLenum format, GLenum type, GLsizei buf_size, GLsizei* length, GLsizei* columns, GLsizei* rows, void* pixels)
+{
+    glReadPixels(x, y, width, height, format, type, pixels);
+    mark_written(length, buf_size);
+    if (columns)
+        *columns = width;
+    if (rows)
+        *rows = height;
+}
+
+void GL_APIENTRY glGetBooleanvRobustANGLE(GLenum pname, GLsizei buf_size, GLsizei* length, GLboolean* data)
+{
+    glGetBooleanv(pname, data);
+    mark_written(length, buf_size);
+}
+
+void GL_APIENTRY glGetBufferParameterivRobustANGLE(GLenum target, GLenum pname, GLsizei buf_size, GLsizei* length, GLint* params)
+{
+    glGetBufferParameteriv(target, pname, params);
+    mark_written(length, buf_size);
+}
+
+void GL_APIENTRY glGetFloatvRobustANGLE(GLenum pname, GLsizei buf_size, GLsizei* length, GLfloat* data)
+{
+    glGetFloatv(pname, data);
+    mark_written(length, buf_size);
+}
+
+void GL_APIENTRY glGetInteger64vRobustANGLE(GLenum pname, GLsizei buf_size, GLsizei* length, GLint64* data)
+{
+    glGetInteger64v(pname, data);
+    mark_written(length, buf_size);
+}
+
+void GL_APIENTRY glGetIntegervRobustANGLE(GLenum pname, GLsizei buf_size, GLsizei* length, GLint* data)
+{
+    glGetIntegerv(pname, data);
+    mark_written(length, buf_size);
+}
+
+void GL_APIENTRY glGetInternalformativRobustANGLE(GLenum target, GLenum internalformat, GLenum pname, GLsizei buf_size, GLsizei* length, GLint* params)
+{
+    glGetInternalformativ(target, internalformat, pname, buf_size, params);
+    mark_written(length, buf_size);
+}
+
+void GL_APIENTRY glGetActiveUniformBlockivRobustANGLE(GLuint program, GLuint uniform_block_index, GLenum pname, GLsizei buf_size, GLsizei* length, GLint* params)
+{
+    glGetActiveUniformBlockiv(program, uniform_block_index, pname, params);
+    mark_written(length, buf_size);
+}
+
+void GL_APIENTRY glGetProgramivRobustANGLE(GLuint program, GLenum pname, GLsizei buf_size, GLsizei* length, GLint* params)
+{
+    glGetProgramiv(program, pname, params);
+    mark_written(length, buf_size);
+}
+
+void GL_APIENTRY glGetQueryObjectuivRobustANGLE(GLuint id, GLenum pname, GLsizei buf_size, GLsizei* length, GLuint* params)
+{
+    glGetQueryObjectuiv(id, pname, params);
+    mark_written(length, buf_size);
+}
+
+void GL_APIENTRY glGetRenderbufferParameterivRobustANGLE(GLenum target, GLenum pname, GLsizei buf_size, GLsizei* length, GLint* params)
+{
+    glGetRenderbufferParameteriv(target, pname, params);
+    mark_written(length, buf_size);
+}
+
+void GL_APIENTRY glGetShaderivRobustANGLE(GLuint shader, GLenum pname, GLsizei buf_size, GLsizei* length, GLint* params)
+{
+    glGetShaderiv(shader, pname, params);
+    mark_written(length, buf_size);
+}
+
+void GL_APIENTRY glGetTexParameterfvRobustANGLE(GLenum target, GLenum pname, GLsizei buf_size, GLsizei* length, GLfloat* params)
+{
+    glGetTexParameterfv(target, pname, params);
+    mark_written(length, buf_size);
+}
+
+void GL_APIENTRY glGetTexParameterivRobustANGLE(GLenum target, GLenum pname, GLsizei buf_size, GLsizei* length, GLint* params)
+{
+    glGetTexParameteriv(target, pname, params);
+    mark_written(length, buf_size);
+}
+
+void GL_APIENTRY glGetVertexAttribPointervRobustANGLE(GLuint index, GLenum pname, GLsizei buf_size, GLsizei* length, void** pointer)
+{
+    glGetVertexAttribPointerv(index, pname, pointer);
+    mark_written(length, buf_size);
+}
+
+void GL_APIENTRY glGetVertexAttribfvRobustANGLE(GLuint index, GLenum pname, GLsizei buf_size, GLsizei* length, GLfloat* params)
+{
+    glGetVertexAttribfv(index, pname, params);
+    mark_written(length, buf_size);
+}
+
+void GL_APIENTRY glGetVertexAttribivRobustANGLE(GLuint index, GLenum pname, GLsizei buf_size, GLsizei* length, GLint* params)
+{
+    glGetVertexAttribiv(index, pname, params);
+    mark_written(length, buf_size);
+}
+
+}
