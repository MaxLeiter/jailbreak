Package: libavdevice59
Version: @DEB_FFMPEG_V@
Architecture: @DEB_ARCH@
Maintainer: @DEB_MAINTAINER@
Section: Libraries
Priority: optional
Depends: libavutil57 (= @DEB_FFMPEG_V@), libavcodec59 (= @DEB_FFMPEG_V@), libavformat59 (= @DEB_FFMPEG_V@), libavfilter8 (= @DEB_FFMPEG_V@), libswscale6 (= @DEB_FFMPEG_V@), libswresample4 (= @DEB_FFMPEG_V@), liblzma5
