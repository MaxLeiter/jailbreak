#!/bin/sh
# gnome-session ships org.gnome.SessionManager.gschema.xml; the manager reads
# org.gnome.SessionManager keys at startup and GLib aborts on an uncompiled schema.
set -e

SCHEMADIR="@MEMO_PREFIX@@MEMO_SUB_PREFIX@/share/glib-2.0/schemas"
GLIB_COMPILE_SCHEMAS="@MEMO_PREFIX@@MEMO_SUB_PREFIX@/bin/glib-compile-schemas"

if [ -d "$SCHEMADIR" ] && [ -x "$GLIB_COMPILE_SCHEMAS" ]; then
    "$GLIB_COMPILE_SCHEMAS" "$SCHEMADIR" || true
fi

exit 0
