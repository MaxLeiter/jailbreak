# mozjs115-jit.mozconfig — JIT-ENABLED SpiderMonkey (ESR 115), Linux→iOS arm64 cross.
# Consumed by recipes/mozjs-jit.mk. Sibling of mozjs115.mozconfig (the JIT-less/shipping
# build); the ONLY functional difference is JIT is left enabled (Baseline + Ion) instead of
# --disable-jit. See docs/mozjs-jit-plan.md (#46).
#
# WHY THIS CAN WORK ON iOS (the old mozconfig said JIT was impossible): on a jailbroken A10
# the W^X-compliant mprotect flip (mmap RW -> write -> mprotect RX -> execute) is permitted
# (de-risked on-device 2026-07-01, ports/mozjs/tools/wxprobe.c). What is NOT permitted on the
# A10: persistent RWX pages (SIGBUS), MAP_JIT (EINVAL), and pthread_jit_write_protect_np is
# absent (no APRR). SpiderMonkey 115 hardcodes that Apple fast-WX path on Darwin/arm64, so it
# is routed to the generic mprotect reprotect path by patches/0005 (runtime-adaptive: fast path
# on A11+, mprotect on A10).
#
# Placeholders substituted by the recipe: @TARGET_SYSROOT@, @CROSS_PREFIX@, @CCTOOLS_BIN@,
# @MOZ_OBJDIR@ (pointed at the JIT variant's own objdir so it never touches the JIT-less build).

ac_add_options --enable-project=js
ac_add_options --target=aarch64-apple-ios
ac_add_options --host=aarch64-unknown-linux-gnu
ac_add_options --enable-linker=ld64

# --- JIT ENABLED (the whole point of this variant) ---
# JIT is default-on; we simply do NOT pass --disable-jit. Baseline interp + Baseline JIT + Ion
# are compiled in. W^X handling is provided by patches/0005 (mprotect path on no-APRR devices).
ac_add_options --disable-jemalloc                   # system allocator; jemalloc fights iOS

# --- embedding shape gjs wants (identical to the JIT-less build) ---
ac_add_options --enable-optimize
ac_add_options --enable-release
ac_add_options --disable-debug
ac_add_options --disable-tests
ac_add_options --with-system-zlib
ac_add_options --enable-readline
ac_add_options --enable-intl-api                     # gjs needs Intl (bundled in-tree ICU)
ac_add_options --enable-shared-js

# --- the cross toolchain (same cctools-port aarch64-apple-darwin) ---
CC="@CROSS_PREFIX@-clang -target arm64-apple-ios14.0 -isysroot @TARGET_SYSROOT@ -B@CCTOOLS_BIN@"
CXX="@CROSS_PREFIX@-clang++ -target arm64-apple-ios14.0 -isysroot @TARGET_SYSROOT@ -stdlib=libc++ -B@CCTOOLS_BIN@"
AR="@CROSS_PREFIX@-ar"
RANLIB="@CROSS_PREFIX@-ranlib"
STRIP="@CROSS_PREFIX@-strip"

export HOST_CC=clang
export HOST_CXX=clang++

export RUSTFLAGS="-Clink-args=-isysroot @TARGET_SYSROOT@"
export IPHONEOS_DEPLOYMENT_TARGET=14.0
mk_add_options MOZ_OBJDIR=@MOZ_OBJDIR@
