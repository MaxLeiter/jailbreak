Depends: qt6-base, qt6-declarative, qt6-sensors, libkscreen, libplasma, plasma-workspace, kf6-config, kf6-dbusaddons, kf6-i18n, kf6-kcmutils, kf6-svg, kf6-xmlgui, layer-shell-qt
