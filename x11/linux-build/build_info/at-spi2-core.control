Package: at-spi2-core
Version: @DEB_ATSPI2_V@
Architecture: @DEB_ARCH@
Maintainer: @DEB_MAINTAINER@
Section: Utilities
Priority: optional
Homepage: https://gitlab.gnome.org/GNOME/at-spi2-core
