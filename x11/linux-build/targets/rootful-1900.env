# Initial rootful smoke target. Do not publish until hardware validation passes.
target_id=rootful-1900
memo_target=iphoneos-arm64
memo_cfver=1900
prefix=
subprefix=/usr
# Procursus maps MEMO_TARGET=iphoneos-arm64 (rootful) to DEB_ARCH iphoneos-arm,
# and only the -rootless target to iphoneos-arm64 (Makefile, the MEMO_TARGET
# case block). Confirmed against a real rootful build, which produced
# libffi8_3.4.6_iphoneos-arm.deb; this field previously guessed iphoneos-arm64.
deb_arch=iphoneos-arm
repo_profile=rootful
version_suffix=+rootful1
package_path_prefix=
runtime_tmp=/var/tmp
runtime_var=/var
default_min_ios=16.0
