ifneq ($(PROCURSUS),1)
$(error Use the main Makefile)
endif

# kholidays.mk — kf6-holidays for rootless iOS (KDE flavor, layer K; docs/kde-plasma-plan.md).
# Added for the 6.7 lane: plasma5support/plasma-workspace 6.7 REQUIRE KF6::Holidays.
# Generated by tools/gen-kf6-recipes.py from the K0 audit table; regenerating
# overwrites hand edits (fold phase-2 fixes back into the table).

SUBPROJECTS += kholidays
KHOLIDAYS_VERSION = $(KF6_VERSION)
DEB_KHOLIDAYS_V ?= $(KHOLIDAYS_VERSION)+ios1

kholidays-setup: setup
	$(call DOWNLOAD_FILES,$(BUILD_SOURCE),$(call KF6_URL,kholidays))
	$(call EXTRACT_TAR,kholidays-$(KF6_VERSION).tar.xz,kholidays-$(KF6_VERSION),kholidays)
	sed -i '/^[[:space:]]*ecm_install_po_files_as_qm(/s/^/# ios-bringup-no-linguist: /' $(BUILD_WORK)/kholidays/CMakeLists.txt
	$(call QT6_WRITE_IOSEXEC_FIXUP)
	$(call QT6_RM_SHADOW_HEADERS)

ifneq ($(wildcard $(BUILD_WORK)/kholidays/.build_complete),)
kholidays:
	@echo "Using previously built kholidays."
else
# Deps come pre-staged from build_base (mutter.mk precedent, no make-level
# prereqs); build-kf6.sh runs the targets in audit wave order.
kholidays: kholidays-setup
	mkdir -p $(BUILD_WORK)/kholidays/build
	cd $(BUILD_WORK)/kholidays/build && cmake .. \
		-G Ninja \
		$(KF6_CMAKE_FLAGS)
	+ninja -C $(BUILD_WORK)/kholidays/build
	+DESTDIR="$(BUILD_STAGE)/kholidays" ninja -C $(BUILD_WORK)/kholidays/build install
	$(call AFTER_BUILD,copy)
endif

kholidays-package: kholidays-stage
	rm -rf $(BUILD_DIST)/kf6-holidays $(BUILD_DIST)/kf6-holidays-dev
	$(call KF6_COPY_RUNTIME,kholidays,kf6-holidays)
	$(call KF6_COPY_DEV,kholidays,kf6-holidays)
	$(call SIGN,kf6-holidays,general.xml)
	$(call SIGN,kf6-holidays-dev,general.xml)
	$(call PACK,kf6-holidays,DEB_KHOLIDAYS_V)
	$(call PACK,kf6-holidays-dev,DEB_KHOLIDAYS_V)
	rm -rf $(BUILD_DIST)/kf6-holidays $(BUILD_DIST)/kf6-holidays-dev

.PHONY: kholidays kholidays-package
