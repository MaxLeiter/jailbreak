ifneq ($(PROCURSUS),1)
$(error Use the main Makefile)
endif

# prison.mk — kf6-prison for rootless iOS (KDE flavor, layer K; docs/kde-plasma-plan.md).
# Added for the 6.7 lane: plasma-workspace (klipper barcode UI) REQUIRES KF6::Prison.
# No backend library is staged (qrencode/libdmtx/zxing-cpp), so the module builds with zero
# generators; Prison reports no barcode support at runtime. Scanner (Qt Multimedia) is off.
# Generated by tools/gen-kf6-recipes.py from the K0 audit table; regenerating
# overwrites hand edits (fold phase-2 fixes back into the table).

SUBPROJECTS += prison
PRISON_VERSION = $(KF6_VERSION)
DEB_PRISON_V ?= $(PRISON_VERSION)+ios1

prison-setup: setup
	$(call DOWNLOAD_FILES,$(BUILD_SOURCE),$(call KF6_URL,prison))
	$(call EXTRACT_TAR,prison-$(KF6_VERSION).tar.xz,prison-$(KF6_VERSION),prison)
	sed -i '/^[[:space:]]*ecm_install_po_files_as_qm(/s/^/# ios-bringup-no-linguist: /' $(BUILD_WORK)/prison/CMakeLists.txt
	$(call QT6_WRITE_IOSEXEC_FIXUP)
	$(call QT6_RM_SHADOW_HEADERS)

ifneq ($(wildcard $(BUILD_WORK)/prison/.build_complete),)
prison:
	@echo "Using previously built prison."
else
# Deps come pre-staged from build_base (mutter.mk precedent, no make-level
# prereqs); build-kf6.sh runs the targets in audit wave order.
prison: prison-setup
	mkdir -p $(BUILD_WORK)/prison/build
	cd $(BUILD_WORK)/prison/build && cmake .. \
		-G Ninja \
		$(KF6_CMAKE_FLAGS) \
		-DWITH_DMTX=OFF \
		-DWITH_ZXING=OFF \
		-DWITH_MULTIMEDIA=OFF \
		-DWITH_QUICK=ON
	+ninja -C $(BUILD_WORK)/prison/build
	+DESTDIR="$(BUILD_STAGE)/prison" ninja -C $(BUILD_WORK)/prison/build install
	$(call AFTER_BUILD,copy)
endif

prison-package: prison-stage
	rm -rf $(BUILD_DIST)/kf6-prison $(BUILD_DIST)/kf6-prison-dev
	$(call KF6_COPY_RUNTIME,prison,kf6-prison)
	$(call KF6_COPY_DEV,prison,kf6-prison)
	$(call SIGN,kf6-prison,general.xml)
	$(call SIGN,kf6-prison-dev,general.xml)
	$(call PACK,kf6-prison,DEB_PRISON_V)
	$(call PACK,kf6-prison-dev,DEB_PRISON_V)
	rm -rf $(BUILD_DIST)/kf6-prison $(BUILD_DIST)/kf6-prison-dev

.PHONY: prison prison-package
