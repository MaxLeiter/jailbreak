ifneq ($(PROCURSUS),1)
$(error Use the main Makefile)
endif

# knighttime.mk — knighttime for rootless iOS (KDE flavor, layer K; docs/kde-plasma-plan.md).
# New in Plasma 6.6/6.7: kwin and plasma-workspace REQUIRE KNightTime. Pulls Qt6::Positioning
# (built in the Qt ladder) and KF6::Holidays.
# Generated by tools/gen-kf6-recipes.py from the K0 audit table; regenerating
# overwrites hand edits (fold phase-2 fixes back into the table).

SUBPROJECTS += knighttime
KNIGHTTIME_VERSION = $(PLASMA_VERSION)
DEB_KNIGHTTIME_V ?= $(KNIGHTTIME_VERSION)+ios1

knighttime-setup: setup
	$(call DOWNLOAD_FILES,$(BUILD_SOURCE),$(call PLASMA_URL,knighttime))
	$(call EXTRACT_TAR,knighttime-$(PLASMA_VERSION).tar.xz,knighttime-$(PLASMA_VERSION),knighttime)
	sed -i '/^[[:space:]]*ecm_install_po_files_as_qm(/s/^/# ios-bringup-no-linguist: /' $(BUILD_WORK)/knighttime/CMakeLists.txt
	$(call QT6_WRITE_IOSEXEC_FIXUP)
	$(call QT6_RM_SHADOW_HEADERS)

ifneq ($(wildcard $(BUILD_WORK)/knighttime/.build_complete),)
knighttime:
	@echo "Using previously built knighttime."
else
# Deps come pre-staged from build_base (mutter.mk precedent, no make-level
# prereqs); build-kf6.sh runs the targets in audit wave order.
knighttime: knighttime-setup
	mkdir -p $(BUILD_WORK)/knighttime/build
	cd $(BUILD_WORK)/knighttime/build && cmake .. \
		-G Ninja \
		$(KF6_CMAKE_FLAGS)
	+ninja -C $(BUILD_WORK)/knighttime/build
	+DESTDIR="$(BUILD_STAGE)/knighttime" ninja -C $(BUILD_WORK)/knighttime/build install
	$(call AFTER_BUILD,copy)
endif

knighttime-package: knighttime-stage
	rm -rf $(BUILD_DIST)/knighttime $(BUILD_DIST)/knighttime-dev
	$(call KF6_COPY_RUNTIME,knighttime,knighttime)
	$(call KF6_COPY_DEV,knighttime,knighttime)
	$(call SIGN,knighttime,general.xml)
	$(call SIGN,knighttime-dev,general.xml)
	$(call PACK,knighttime,DEB_KNIGHTTIME_V)
	$(call PACK,knighttime-dev,DEB_KNIGHTTIME_V)
	rm -rf $(BUILD_DIST)/knighttime $(BUILD_DIST)/knighttime-dev

.PHONY: knighttime knighttime-package
