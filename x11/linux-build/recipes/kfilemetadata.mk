ifneq ($(PROCURSUS),1)
$(error Use the main Makefile)
endif

# kfilemetadata.mk — kf6-filemetadata for rootless iOS (KDE flavor, layer K; docs/kde-plasma-plan.md).
# Added for the Gear 26.08 lane: dolphin REQUIRES KF6::FileMetaData. Optional extractor
# backends (taglib, ffmpeg, poppler, exiv2, ...) are simply not found and stay off.
# Generated by tools/gen-kf6-recipes.py from the K0 audit table; regenerating
# overwrites hand edits (fold phase-2 fixes back into the table).

SUBPROJECTS += kfilemetadata
KFILEMETADATA_VERSION = $(KF6_VERSION)
DEB_KFILEMETADATA_V ?= $(KFILEMETADATA_VERSION)+ios1

kfilemetadata-setup: setup
	$(call DOWNLOAD_FILES,$(BUILD_SOURCE),$(call KF6_URL,kfilemetadata))
	$(call EXTRACT_TAR,kfilemetadata-$(KF6_VERSION).tar.xz,kfilemetadata-$(KF6_VERSION),kfilemetadata)
	sed -i '/^[[:space:]]*ecm_install_po_files_as_qm(/s/^/# ios-bringup-no-linguist: /' $(BUILD_WORK)/kfilemetadata/CMakeLists.txt
	$(call QT6_WRITE_IOSEXEC_FIXUP)
	$(call QT6_RM_SHADOW_HEADERS)

ifneq ($(wildcard $(BUILD_WORK)/kfilemetadata/.build_complete),)
kfilemetadata:
	@echo "Using previously built kfilemetadata."
else
# Deps come pre-staged from build_base (mutter.mk precedent, no make-level
# prereqs); build-kf6.sh runs the targets in audit wave order.
kfilemetadata: kfilemetadata-setup
	mkdir -p $(BUILD_WORK)/kfilemetadata/build
	cd $(BUILD_WORK)/kfilemetadata/build && cmake .. \
		-G Ninja \
		$(KF6_CMAKE_FLAGS) \
		-DBUILD_TESTING=OFF
	+ninja -C $(BUILD_WORK)/kfilemetadata/build
	+DESTDIR="$(BUILD_STAGE)/kfilemetadata" ninja -C $(BUILD_WORK)/kfilemetadata/build install
	$(call AFTER_BUILD,copy)
endif

kfilemetadata-package: kfilemetadata-stage
	rm -rf $(BUILD_DIST)/kf6-filemetadata $(BUILD_DIST)/kf6-filemetadata-dev
	$(call KF6_COPY_RUNTIME,kfilemetadata,kf6-filemetadata)
	$(call KF6_COPY_DEV,kfilemetadata,kf6-filemetadata)
	$(call SIGN,kf6-filemetadata,general.xml)
	$(call SIGN,kf6-filemetadata-dev,general.xml)
	$(call PACK,kf6-filemetadata,DEB_KFILEMETADATA_V)
	$(call PACK,kf6-filemetadata-dev,DEB_KFILEMETADATA_V)
	rm -rf $(BUILD_DIST)/kf6-filemetadata $(BUILD_DIST)/kf6-filemetadata-dev

.PHONY: kfilemetadata kfilemetadata-package
