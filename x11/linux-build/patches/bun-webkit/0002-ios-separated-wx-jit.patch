diff --git a/Source/WTF/wtf/posix/OSAllocatorPOSIX.cpp b/Source/WTF/wtf/posix/OSAllocatorPOSIX.cpp
index 4177872a7c5..b084a165895 100644
--- a/Source/WTF/wtf/posix/OSAllocatorPOSIX.cpp
+++ b/Source/WTF/wtf/posix/OSAllocatorPOSIX.cpp
@@ -109,12 +109,19 @@ void* OSAllocator::tryReserveAndCommitImpl(size_t bytes, Usage usage, void* addr
     int flags = MAP_PRIVATE | MAP_ANON;
 #if OS(DARWIN)
     UNUSED_PARAM(uncommitted);
+#if OS(IOS_FAMILY)
+    // MAP_JIT is refused outright without the dynamic-codesigning entitlement,
+    // and it is not what makes the pool executable here: the separated W^X
+    // alias is. Asking for it only fails the reservation.
+    UNUSED_PARAM(jitCageEnabled);
+#else
     if (executable) {
         if (jitCageEnabled)
             flags |= MAP_EXECUTABLE_FOR_JIT_WITH_JIT_CAGE;
         else
             flags |= MAP_EXECUTABLE_FOR_JIT;
     }
+#endif
 #elif OS(LINUX) || OS(HAIKU)
     UNUSED_PARAM(jitCageEnabled);
     if (uncommitted)
@@ -279,6 +286,27 @@ void* OSAllocator::reserveAndCommit(size_t bytes, Usage usage, void* address, bo
 
 void OSAllocator::commit(void* address, size_t bytes, bool writable, bool executable)
 {
+#if OS(IOS_FAMILY)
+    // iOS will not fault a dirty anonymous page into an executable mapping, but
+    // it will re-protect a page that already has an entry there. So every page
+    // of the JIT pool has to pass through this mapping as RW once, before
+    // anything executes out of it; after that the separated W^X alias can write
+    // to it freely. This is that pass, and it is why initializeSeparatedWXHeaps()
+    // leaves this mapping's maximum protection at RWX.
+    if (executable) {
+        if (mprotect(address, bytes, PROT_READ | PROT_WRITE))
+            CRASH();
+        // Touch every page to force it resident, but read-modify-write rather
+        // than zeroing: with concurrent DFG this range can already hold live
+        // code, and clearing it is how the first version of this hung opencode.
+        volatile uint8_t* p = static_cast<volatile uint8_t*>(address);
+        for (size_t i = 0; i < bytes; i += pageSize())
+            p[i] = p[i];
+        if (mprotect(address, bytes, PROT_READ | PROT_EXEC))
+            CRASH();
+    }
+#endif
+
 #if OS(LINUX) || OS(HAIKU) || OS(QNX)
     UNUSED_PARAM(writable);
     UNUSED_PARAM(executable);
