--- tccrun.c
+++ tccrun.c
@@ -134,7 +134,12 @@
     /* Generated code is page-protected below; avoid changing CRT heap pages. */
     ptr = VirtualAlloc(NULL, size, MEM_RESERVE | MEM_COMMIT, PAGE_READWRITE);
 # else
-    ptr = tcc_malloc(size += PAGESIZE); /* one extra page to align malloc memory */
+    /* iOS: executable run memory must come from mmap, not the heap; mprotect
+       on malloc'd pages returns EINVAL. An mmap'd anon region can go r-w -> r-x. */
+    size += PAGESIZE; /* one extra page to align the base */
+    ptr = mmap(NULL, size, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANON, -1, 0);
+    if (ptr == MAP_FAILED)
+        return tcc_error_noabort("tccrun: could not map memory");
 # endif
 #endif
     if (!ptr)
@@ -202,12 +207,8 @@
 #  endif
     VirtualFree(ptr, 0, MEM_RELEASE);
 # else
-    /* unprotect memory to make it usable for malloc again */
-    protect_pages((void*)PAGEALIGN(ptr), size - PAGESIZE, 2 /*rw*/);
-# ifdef _WIN64
-    win64_del_function_table(s1->run_function_table);
-# endif
-    tcc_free(ptr);
+    /* iOS: run memory is mmap'd in rt_mem (see above); release with munmap. */
+    munmap(ptr, size);
 # endif
 #endif
 }
@@ -507,8 +508,14 @@
 /* XXX: BSD sometimes dump core with bad system call */
 # if (defined TCC_TARGET_ARM && !TARGETOS_BSD) || defined TCC_TARGET_ARM64 || defined TCC_TARGET_RISCV64
     if (mode == 0 || mode == 3) {
+#  if defined(__APPLE__)
+        /* Apple arm64 has no libgcc __clear_cache; use the OS icache flush. */
+        void sys_icache_invalidate(void *start, size_t len);
+        sys_icache_invalidate(ptr, length);
+#  else
         void __clear_cache(void *beginning, void *end);
         __clear_cache(ptr, (char *)ptr + length);
+#  endif
     }
 # endif
 #endif
