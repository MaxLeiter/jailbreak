+static void
+log_pick_tree (ClutterActor *actor,
+               int           depth)
+{
+  ClutterActor *child;
+  ClutterActorBox box;
+  float tx = 0.0f;
+  float ty = 0.0f;
+
+  if (!actor || depth > 3)
+    return;
+
+  clutter_actor_get_allocation_box (actor, &box);
+  clutter_actor_get_transformed_position (actor, &tx, &ty);
+
+  g_message ("MetaWaylandPointerIOS: tree depth=%d actor=%s mapped=%d "
+             "visible=%d reactive=%d alloc=%.1f,%.1f %.1fx%.1f "
+             "transformed=%.1f,%.1f wayland=%d",
+             depth,
+             G_OBJECT_TYPE_NAME (actor),
+             clutter_actor_is_mapped (actor),
+             clutter_actor_is_visible (actor),
+             clutter_actor_get_reactive (actor),
+             box.x1, box.y1, box.x2 - box.x1, box.y2 - box.y1,
+             tx, ty,
+             META_IS_SURFACE_ACTOR_WAYLAND (actor));
+
+  for (child = clutter_actor_get_first_child (actor);
+       child;
+       child = clutter_actor_get_next_sibling (child))
+    log_pick_tree (child, depth + 1);
+}
