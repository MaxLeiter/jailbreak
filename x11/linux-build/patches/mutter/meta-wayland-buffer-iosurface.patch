     case META_WAYLAND_BUFFER_TYPE_UNKNOWN:
       g_assert_not_reached ();
       return FALSE;
@@ -830,6 +838,7 @@
 #endif
     case META_WAYLAND_BUFFER_TYPE_DMA_BUF:
