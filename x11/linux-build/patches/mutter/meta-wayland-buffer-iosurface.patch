 typedef enum _MetaWaylandBufferType
 {
@@ -41,6 +42,7 @@
 #endif
   META_WAYLAND_BUFFER_TYPE_DMA_BUF,
   META_WAYLAND_BUFFER_TYPE_SINGLE_PIXEL,
+  META_WAYLAND_BUFFER_TYPE_IOSURFACE,
 } MetaWaylandBufferType;
 
 struct _MetaWaylandBuffer
