# Wire the iosc_iosurface Wayland global into mutter's per-compositor bring-up.
# Adds the wayland/meta-wayland-iosurface.h include (alphabetically, with the
# other wayland/ includes) and calls meta_wayland_iosurface_init (compositor)
# in meta_wayland_compositor_new(), right after init_dma_buf_support() — the
# iOS analogue slots in exactly where linux-dmabuf does. The init routine and
# the IOSurface MetaWaylandBuffer type live in
# src/wayland/meta-wayland-iosurface.{c,h}; this is just the registration.
# Depends on meta-wayland-buffer-iosurface.patch. Verified compile-clean
# against mutter 46.0 (wayland_meta-wayland.c.o builds, zero new diagnostics
# vs the pristine source). GPL-2.0+.
#
--- a/src/wayland/meta-wayland.c	2026-07-01 02:29:00.000000000 +0000
+++ b/src/wayland/meta-wayland.c	2026-07-01 02:29:00.000000000 +0000
@@ -47,6 +47,7 @@
 #include "wayland/meta-wayland-idle-inhibit.h"
 #include "wayland/meta-wayland-inhibit-shortcuts-dialog.h"
 #include "wayland/meta-wayland-inhibit-shortcuts.h"
+#include "backends/ios/meta-wayland-iosurface.h"
 #include "wayland/meta-wayland-legacy-xdg-foreign.h"
 #include "wayland/meta-wayland-outputs.h"
 #include "wayland/meta-wayland-presentation-time-private.h"
@@ -860,6 +861,7 @@
   meta_wayland_xdg_foreign_init (compositor);
   meta_wayland_legacy_xdg_foreign_init (compositor);
   init_dma_buf_support (compositor);
+  meta_wayland_iosurface_init (compositor);
   meta_wayland_init_single_pixel_buffer_manager (compositor);
   meta_wayland_keyboard_shortcuts_inhibit_init (compositor);
   meta_wayland_surface_inhibit_shortcuts_dialog_init ();
