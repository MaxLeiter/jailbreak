#!/usr/bin/env bash
# Host-side Xios device testing harness.
#
# Wraps the repo's existing SSH/device configuration and on-device helpers so
# agents do not have to rewrite long ssh/scp snippets for every verification.
set -u

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
X11_ROOT="$(cd "$HERE/.." && pwd)"
DEPLOY_ENV="$X11_ROOT/apps/iosc-desktop/deploy-env.sh"

if [ ! -r "$DEPLOY_ENV" ]; then
    echo "xios-device: missing deploy env: $DEPLOY_ENV" >&2
    exit 1
fi

# shellcheck source=../apps/iosc-desktop/deploy-env.sh
. "$DEPLOY_ENV"

TMP_REMOTE=/var/jb/tmp
ARTIFACT_ROOT="${XIOS_ARTIFACT_ROOT:-$X11_ROOT/artifacts/device-runs}"

usage() {
    cat <<'EOF'
usage: bin/xios-device <command> [args]

Commands:
  doctor
      Check host tools, SSH reachability, and key on-device Xios helpers.

  status [--slot NAME]
      Print current Xios/iosc/Mutter/GNOME/KDE status and important tmp files.

  session [--via-daemon] [--slot NAME] [--width W --height H --dpi DPI] PRESET
      Run xios-session on the device. PRESET is one of iosc, mutter, gnome,
      kde, kde-nano, kde-mobile, stop, or status. Width/height/dpi are passed
      through to session presets that honor them.

  app [--slot NAME] NAME
      Launch an app client through the current xios-session, e.g. app kgx.

  foreground
      Ask FrontBoard to foreground com.max.xios and print adoption status.

  input [--mutter|--iosc|--socket PATH] [--logical] MODE ARGS...
      Inject deterministic input through iosc-input-test.
      Modes map directly to iosc-input-test: click, drag, scroll, touch, pencil,
      key, type.

      COORDINATES ARE PHYSICAL OUTPUT PIXELS by default, because that is what the
      iosc input protocol carries. Window geometry from KWin, kwin scripting and
      `workspace.windowList()` is LOGICAL, so on a scale-2 output a click aimed at
      a logical coordinate lands at half the intended position -- silently, since
      the click still succeeds somewhere. Pass --logical to give logical
      coordinates and have them scaled by the output ratio from xios.json.

  shot [--slot NAME] [OUTDIR]
      Capture visual evidence. Tries Wayland grim first, then iosc-screenshot-test
      probe output, then host idevicescreenshot if a paired device is visible.
      Also collects status/log files into OUTDIR.

  collect [--slot NAME] [OUTDIR]
      Copy status files and logs from /var/jb/tmp into OUTDIR.

  push LOCAL [REMOTE]
      Copy one local file into /var/jb/tmp on the device. REMOTE defaults to
      /var/jb/tmp/LOCAL_BASENAME and cannot point outside /var/jb/tmp.

  logs [PATTERN]
      Print recent compositor/session log lines, optionally filtered by PATTERN.

  exec COMMAND...
      Run an arbitrary bash command on the device through the shared SSH config.

Environment:
  XIOS_ARTIFACT_ROOT   Local root for shot/collect artifacts.
  device.env           Repo-root device config consumed by deploy-env.sh.
EOF
}

die() {
    echo "xios-device: $*" >&2
    exit 1
}

stamp() {
    date '+%Y%m%d-%H%M%S'
}

make_outdir() {
    local requested="${1:-}"
    if [ -n "$requested" ]; then
        mkdir -p "$requested" || exit 1
        (cd "$requested" && pwd)
    else
        local d="$ARTIFACT_ROOT/$(stamp)"
        mkdir -p "$d" || exit 1
        printf '%s\n' "$d"
    fi
}

sanitize_slot() {
    local raw="$1" slot
    slot="$(printf '%s' "$raw" | tr -c 'A-Za-z0-9_.-' '-' | sed 's/^-*//; s/-*$//; s/--*/-/g' | cut -c1-48)"
    [ -n "$slot" ] || die "invalid slot name: $raw"
    printf '%s\n' "$slot"
}

remote() {
    printf '%s\n' "$1" | ssh_ bash -s
}

copy_remote_if_exists() {
    local remote_path="$1" outdir="$2" name="${3:-}"
    [ -n "$name" ] || name="$(basename "$remote_path")"
    if ssh_ test -r "$remote_path" 2>/dev/null; then
        if scp_ "root@$IP:$remote_path" "$outdir/$name" >/dev/null 2>&1; then
            printf 'copied %s\n' "$outdir/$name"
        elif ssh_ cat "$remote_path" > "$outdir/$name" 2>/dev/null; then
            printf 'copied %s\n' "$outdir/$name"
        fi
    fi
}

collect_files() {
    local outdir="$1" slot="${2:-}"
    mkdir -p "$outdir" || exit 1

    remote 'ps ax > /var/jb/tmp/xios-ps.txt 2>/dev/null || true; \
        (df -h /var/jb /var/jb/tmp 2>/dev/null || true) > /var/jb/tmp/xios-df.txt; \
        (launchctl print system/com.max.xios-sessiond 2>/dev/null || true) > /var/jb/tmp/xios-sessiond.launchctl.txt'

    local files=(
        xios.json
        xios-status.txt
        xios-geom.txt
        xios-touch.log
        xios-session-status.json
        xios-active-session
        xios-ps.txt
        xios-df.txt
        xios-sessiond.launchctl.txt
        iosc.log
        iosc-client.log
        kgx.log
        gnome-shell.log
        kde-plasma.log
        mutter.log
        gs-live.log
        ioscd.log
    )
    local f
    for f in "${files[@]}"; do
        copy_remote_if_exists "$TMP_REMOTE/$f" "$outdir" "$f"
    done
    if [ -n "$slot" ]; then
        copy_remote_if_exists "$TMP_REMOTE/xios-session-$slot.json" "$outdir" "xios-session-$slot.json"
        copy_remote_if_exists "$TMP_REMOTE/xios-$slot.json" "$outdir" "xios-$slot.json"
        copy_remote_if_exists "$TMP_REMOTE/iosc-$slot.log" "$outdir" "iosc-$slot.log"
        copy_remote_if_exists "$TMP_REMOTE/kde-plasma-$slot.log" "$outdir" "kde-plasma-$slot.log"
        copy_remote_if_exists "$TMP_REMOTE/xios-displays.d/$slot.json" "$outdir" "xios-display-$slot.json"
    fi
}

cmd_doctor() {
    echo "== host"
    echo "repo: $X11_ROOT"
    echo "target: root@$IP:$PORT"
    echo "key: $KEY"
    command -v ssh >/dev/null && echo "ssh: $(command -v ssh)" || echo "ssh: missing"
    command -v scp >/dev/null && echo "scp: $(command -v scp)" || echo "scp: missing"
    command -v idevicescreenshot >/dev/null && echo "idevicescreenshot: $(command -v idevicescreenshot)" || echo "idevicescreenshot: missing"
    if command -v idevice_id >/dev/null; then
        echo "idevice_id usb: $(idevice_id -l 2>/dev/null | tr '\n' ' ' || true)"
        echo "idevice_id network: $(idevice_id -n -l 2>/dev/null | tr '\n' ' ' || true)"
    else
        echo "idevice_id: missing"
    fi

    echo
    echo "== device"
    remote '
        echo "reachable: yes"
        uname -a
        test -d /var/jb && echo "rootless: /var/jb present" || echo "rootless: /var/jb missing"
        for p in \
            /var/jb/usr/local/bin/xios-session \
            /var/jb/usr/local/bin/iosc-input-test \
            /var/jb/usr/local/bin/iosc-screenshot-test \
            /var/jb/usr/bin/grim \
            /var/jb/usr/local/bin/iosc \
            /var/jb/Applications/Xios.app/Xios
        do
            if [ -e "$p" ]; then
                ls -ld "$p"
            else
                echo "missing: $p"
            fi
        done
    ' || exit $?
}

cmd_status() {
    local slot=""
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --slot) slot="$(sanitize_slot "${2:-}")"; shift 2 ;;
            --slot=*) slot="$(sanitize_slot "${1#--slot=}")"; shift ;;
            --help|-h) usage; exit 0 ;;
            *) die "unknown status option: $1" ;;
        esac
    done
    if [ -n "$slot" ]; then
        remote "
        echo \"== process summary\"
        ps ax | grep -v grep | grep -E \"ioscd|xios-session .*--slot[ =]$slot|wayland-$slot|iosc-$slot|kwin-$slot|kde-plasma-$slot\" || true
        echo
        echo \"== slot session status\"
        cat /var/jb/tmp/xios-session-$slot.json 2>/dev/null || echo \"(no xios-session-$slot.json)\"
        echo
        echo \"== slot display registry\"
        cat /var/jb/tmp/xios-displays.d/$slot.json 2>/dev/null || echo \"(no slot registry)\"
        echo
        echo \"== slot xios.json\"
        cat /var/jb/tmp/xios-$slot.json 2>/dev/null || echo \"(no xios-$slot.json)\"
        echo
        echo \"== active session\"
        cat /var/jb/tmp/xios-active-session 2>/dev/null || echo \"(no xios-active-session)\"
    "
        return
    fi
    remote '
        echo "== process summary"
        ps ax | grep -v grep | grep -E "Xios\.app/Xios|/usr/local/bin/iosc|bin/gnome-shell|bin/mutter|kwin_wayland|plasmashell|plasmawindowed|bin/kgx|xios-sessiond|ioscd" || true
        echo
        echo "== session status"
        cat /var/jb/tmp/xios-session-status.json 2>/dev/null || echo "(no xios-session-status.json)"
        echo
        echo "== active session"
        cat /var/jb/tmp/xios-active-session 2>/dev/null || echo "(no xios-active-session)"
        echo
        echo "== xios.json"
        cat /var/jb/tmp/xios.json 2>/dev/null || echo "(no xios.json)"
        echo
        echo "== app status"
        cat /var/jb/tmp/xios-status.txt 2>/dev/null || echo "(no xios-status.txt)"
        echo
        echo "== app geom"
        cat /var/jb/tmp/xios-geom.txt 2>/dev/null || echo "(no xios-geom.txt)"
        echo
        echo "== recent touch"
        tail -n 12 /var/jb/tmp/xios-touch.log 2>/dev/null || echo "(no xios-touch.log)"
    '
}

cmd_session() {
    local via=0 width="" height="" dpi="" slot=""
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --via-daemon) via=1; shift ;;
            --slot) slot="$(sanitize_slot "${2:-}")"; shift 2 ;;
            --slot=*) slot="$(sanitize_slot "${1#--slot=}")"; shift ;;
            --width) width="${2:-}"; [ -n "$width" ] || die "--width needs a value"; shift 2 ;;
            --height) height="${2:-}"; [ -n "$height" ] || die "--height needs a value"; shift 2 ;;
            --dpi) dpi="${2:-}"; [ -n "$dpi" ] || die "--dpi needs a value"; shift 2 ;;
            --help|-h) usage; exit 0 ;;
            --*) die "unknown session option: $1" ;;
            *) break ;;
        esac
    done
    local preset="${1:-}"
    [ -n "$preset" ] || die "session preset required"
    case "$preset" in
        iosc|mutter|gnome|kde|plasma|kde-desktop|plasma-desktop|kde-nano|plasma-nano|nano|kde-mobile|plasma-mobile|mobile|stop|status) ;;
        *) die "unknown session preset: $preset" ;;
    esac

    local env_prefix=""
    [ -n "$width" ] && env_prefix="$env_prefix XIOS_SESSION_WIDTH=$width"
    [ -n "$height" ] && env_prefix="$env_prefix XIOS_SESSION_HEIGHT=$height"
    [ -n "$dpi" ] && env_prefix="$env_prefix XIOS_SESSION_DPI=$dpi"
    local daemon_arg=""
    [ "$via" = 1 ] && daemon_arg="--via-daemon"
    local slot_arg=""
    [ -n "$slot" ] && slot_arg="--slot $(printf '%q' "$slot")"

    remote "export PATH=/var/jb/usr/local/bin:/var/jb/usr/bin:/var/jb/bin:\$PATH; $env_prefix xios-session $slot_arg $daemon_arg $preset"
}

cmd_app() {
    local slot=""
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --slot) slot="$(sanitize_slot "${2:-}")"; shift 2 ;;
            --slot=*) slot="$(sanitize_slot "${1#--slot=}")"; shift ;;
            --help|-h) usage; exit 0 ;;
            --*) die "unknown app option: $1" ;;
            *) break ;;
        esac
    done
    local app="${1:-}"
    [ -n "$app" ] || die "app name required"
    local slot_arg=""
    [ -n "$slot" ] && slot_arg="--slot $(printf '%q' "$slot")"
    remote "export PATH=/var/jb/usr/local/bin:/var/jb/usr/bin:/var/jb/bin:\$PATH; xios-session $slot_arg app $(printf '%q' "$app")"
}

cmd_foreground() {
    remote '
        uiopen -b com.max.xios 2>/dev/null || uiopen com.max.xios 2>/dev/null || true
        for i in $(seq 1 20); do
            grep -q "iosurface-zerocopy" /var/jb/tmp/xios-status.txt 2>/dev/null && break
            sleep 0.5
        done
        cat /var/jb/tmp/xios-status.txt 2>/dev/null || true
    '
}

# Physical/logical ratio of the live output: xios.json's physical width against
# the logical width iosc logged. Prints NOTHING when it cannot be determined, so
# the caller can tell "could not read" apart from "the scale really is 1".
output_scale() {
    local dims phys logical
    # One round trip, not two.
    # Each value is printed on a labelled line. Without labels a missing first
    # value collapses the output to one line and line 1 would silently be the
    # OTHER number -- which would produce a plausible-looking wrong scale.
    dims="$(remote '
        printf "phys=%s\n" "$(sed -n "s/.*\"width\":[[:space:]]*\([0-9][0-9]*\).*/\1/p" /var/jb/tmp/xios.json 2>/dev/null | head -1)"
        printf "logical=%s\n" "$(sed -n "s/.*logical=\([0-9][0-9]*\)x[0-9][0-9]*.*/\1/p" /var/jb/tmp/iosc.log 2>/dev/null | tail -1)"
    ')" || return 1
    phys="$(printf '%s\n' "$dims" | sed -n 's/^phys=//p')"
    logical="$(printf '%s\n' "$dims" | sed -n 's/^logical=//p')"
    case "${phys:-x}" in *[!0-9]*) return 1 ;; esac
    case "${logical:-x}" in *[!0-9]*) return 1 ;; esac
    [ "$logical" -gt 0 ] || return 1
    printf '%s\n' $(( phys / logical ))
}

# How many LEADING arguments of each input mode are coordinates. The rest must be
# left alone: scroll's trailing dx/dy are wheel deltas in scroll units, not
# pixels, so scaling them would silently change how far the wheel turned.
input_coord_count() {
    case "$1" in
        click|touch)  printf '2\n' ;;
        drag|pencil)  printf '4\n' ;;
        scroll)       printf '2\n' ;;   # X Y are pixels; DX DY are deltas
        *)            printf '0\n' ;;
    esac
}

cmd_input() {
    local socket_args=() logical=0
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --mutter|--iosc) socket_args+=("$1"); shift ;;
            --socket) socket_args+=("$1" "${2:-}"); [ -n "${2:-}" ] || die "--socket needs a path"; shift 2 ;;
            --logical) logical=1; shift ;;
            --help|-h) usage; exit 0 ;;
            *) break ;;
        esac
    done
    local mode="${1:-}"
    [ -n "$mode" ] || die "input mode required"
    shift

    # --logical: convert logical coordinates to the physical pixels the iosc input
    # protocol carries. Only the LEADING coordinate arguments of each mode are
    # scaled (see input_coord_count) -- never trailing deltas.
    if [ "$logical" = 1 ]; then
        local ncoord scale
        ncoord="$(input_coord_count "$mode")"
        if [ "$ncoord" = 0 ]; then
            echo "xios-device: --logical has no effect for mode '$mode' (no coordinates)" >&2
        elif ! scale="$(output_scale)"; then
            die "--logical: could not determine output scale (need xios.json + iosc.log on device); re-run without --logical and pass physical pixels"
        elif [ "$scale" = 1 ]; then
            : # output is 1:1, logical == physical, nothing to do
        else
            local scaled=() i=0 a
            for a in "$@"; do
                i=$((i + 1))
                if [ "$i" -le "$ncoord" ] && [ -z "${a//[0-9]/}" ] && [ -n "$a" ]; then
                    scaled+=("$(( a * scale ))")
                else
                    scaled+=("$a")
                fi
            done
            set -- "${scaled[@]}"
            echo "xios-device: --logical x$scale -> $mode $*" >&2
        fi
    fi

    local test_bin=/var/jb/usr/local/bin/iosc-input-test
    # Bash 3.2 + set -u treats expansion of an empty array as an unbound
    # variable. Build this after a length check so the default auto-detected
    # input socket works on the macOS host.
    local args=()
    if [ "${#socket_args[@]}" -gt 0 ]; then
        args=("${socket_args[@]}")
    fi
    case "$mode" in
        click)  [ "$#" -eq 2 ] || die "click needs X Y"; args+=("-c" "$1" "$2") ;;
        drag)   [ "$#" -eq 4 ] || die "drag needs X0 Y0 X1 Y1"; args+=("-D" "$1" "$2" "$3" "$4") ;;
        scroll) [ "$#" -eq 4 ] || die "scroll needs X Y DX DY"; args+=("-s" "$1" "$2" "$3" "$4") ;;
        touch)  [ "$#" -eq 2 ] || die "touch needs X Y"; args+=("-t" "$1" "$2") ;;
        pencil) [ "$#" -eq 4 ] || die "pencil needs X0 Y0 X1 Y1"; args+=("-p" "$1" "$2" "$3" "$4") ;;
        key)    [ "$#" -ge 1 ] || die "key needs KEYSYM [MODS]"; args+=("-k" "$@") ;;
        type)   [ "$#" -ge 1 ] || die "type needs text"; args+=("$@") ;;
        *) die "unknown input mode: $mode" ;;
    esac

    local quoted=""
    local a
    for a in "${args[@]}"; do
        quoted+=" $(printf '%q' "$a")"
    done
    remote "test -x $test_bin || { echo 'missing $test_bin' >&2; exit 1; }; $test_bin$quoted"
}

cmd_shot() {
    local slot="" outarg=""
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --slot) slot="$(sanitize_slot "${2:-}")"; shift 2 ;;
            --slot=*) slot="$(sanitize_slot "${1#--slot=}")"; shift ;;
            --help|-h) usage; exit 0 ;;
            --*) die "unknown shot option: $1" ;;
            *) outarg="$1"; shift ;;
        esac
    done
    local outdir
    outdir="$(make_outdir "$outarg")" || exit 1
    echo "artifact dir: $outdir"

    local wayland="wayland-0"
    local runtime="/var/jb/tmp"
    if [ -n "$slot" ]; then
        wayland="wayland-$slot"
        runtime="/var/jb/tmp"
    fi
    local q_slot q_wayland q_runtime
    q_slot="$(printf '%q' "$slot")"
    q_wayland="$(printf '%q' "$wayland")"
    q_runtime="$(printf '%q' "$runtime")"
    remote "
        export PATH=/var/jb/usr/local/bin:/var/jb/usr/bin:/var/jb/bin:\$PATH
        slot=$q_slot
        runtime=$q_runtime
        wayland=$q_wayland
        if [ -n \"\$slot\" ]; then
            if [ -d \"/var/jb/tmp/xios-kde-runtime-\$slot\" ]; then
                runtime=\"/var/jb/tmp/xios-kde-runtime-\$slot\"
            fi
        else
            active=\"\$(cat /var/jb/tmp/xios-active-session 2>/dev/null || true)\"
            case \"\$active\" in
                kde|kde-desktop|kde-nano|kde-mobile|plasma|plasma-desktop|plasma-nano|plasma-mobile)
                    runtime=/var/jb/tmp/xios-kde-runtime ;;
            esac
        fi
        export XDG_RUNTIME_DIR=\$runtime
        export WAYLAND_DISPLAY=\$wayland
        rm -f /var/jb/tmp/xios-shot.png /var/jb/tmp/xios-shot.log
        : > /var/jb/tmp/xios-shot.log
        printf 'shot runtime=%s wayland=%s\n' \"\$XDG_RUNTIME_DIR\" \"\$WAYLAND_DISPLAY\" >> /var/jb/tmp/xios-shot.log
        if command -v grim >/dev/null 2>&1; then
            grim /var/jb/tmp/xios-shot.png >> /var/jb/tmp/xios-shot.log 2>&1 || true
        fi
        if [ ! -s /var/jb/tmp/xios-shot.png ] && command -v iosc-screenshot-test >/dev/null 2>&1; then
            iosc-screenshot-test >> /var/jb/tmp/xios-shot.log 2>&1 || true
        fi
        if [ ! -s /var/jb/tmp/xios-shot.png ] && [ ! -s /var/jb/tmp/xios-shot.log ]; then
            printf '%s\n' 'no grim or iosc-screenshot-test on device' > /var/jb/tmp/xios-shot.log
        fi
        # Independent second opinion from the compositor itself. A grim PNG cannot
        # distinguish 'the output really is black' from 'the capture is broken';
        # IOSC_PROBE makes the compositor print its own app-space pixel map, which
        # can. Run it ALWAYS, not just when the PNG is missing -- an all-black run
        # produces a perfectly valid non-empty PNG and would otherwise skip this.
        if command -v iosc-screenshot-test >/dev/null 2>&1; then
            printf -- '--- iosc-screenshot-test probe ---\n' >> /var/jb/tmp/xios-shot.log
            IOSC_PROBE=1 iosc-screenshot-test >> /var/jb/tmp/xios-shot.log 2>&1 || true
        fi
        ls -l /var/jb/tmp/xios-shot.png /var/jb/tmp/xios-shot.log 2>/dev/null || true
    "

    copy_remote_if_exists "$TMP_REMOTE/xios-shot.png" "$outdir" "compositor.png"
    copy_remote_if_exists "$TMP_REMOTE/xios-shot.log" "$outdir" "compositor-shot.log"

    # Report whether the captured frame actually has pixels. "Black" must be a
    # stated measurement, not something inferred from a file size -- an all-zero
    # 2880x2160 PNG is a valid, correctly-formed 18240-byte file, so size alone
    # looks indistinguishable from a healthy capture.
    if [ -s "$outdir/compositor.png" ] && command -v python3 >/dev/null 2>&1; then
        python3 - "$outdir/compositor.png" <<'PYEOF' | tee -a "$outdir/compositor-shot.log"
import sys, zlib, struct
p = sys.argv[1]
d = open(p, 'rb').read()
idat, pos, w, h = b'', 8, 0, 0
while pos < len(d):
    ln = struct.unpack('>I', d[pos:pos+4])[0]
    typ = d[pos+4:pos+8]
    if typ == b'IHDR':
        w, h = struct.unpack('>II', d[pos+8:pos+16])
        ct = d[pos+17]
    elif typ == b'IDAT':
        idat += d[pos+8:pos+8+ln]
    pos += 12 + ln
raw = zlib.decompress(idat)
# Count non-black PIXELS, which means undoing the PNG line filters first.
# Counting non-zero BYTES of the raw (still filtered) stream looks like it
# measures content but does not: filters emit zeros for smooth runs, so a
# uniform window-filled desktop scores LOWER than a noisy wallpaper. Only the
# all-zero case was ever trustworthy.
bpp = {0: 1, 2: 3, 4: 2, 6: 4}.get(ct, 3)
stride = w * bpp
prev = bytearray(stride)
nz = 0
o = 0
for _ in range(h):
    if o >= len(raw):
        break
    ft = raw[o]; o += 1
    line = bytearray(raw[o:o + stride]); o += stride
    if ft == 1:
        for i in range(bpp, stride):
            line[i] = (line[i] + line[i - bpp]) & 255
    elif ft == 2:
        for i in range(stride):
            line[i] = (line[i] + prev[i]) & 255
    elif ft == 3:
        for i in range(stride):
            line[i] = (line[i] + ((line[i - bpp] if i >= bpp else 0) + prev[i]) // 2) & 255
    elif ft == 4:
        for i in range(stride):
            a = line[i - bpp] if i >= bpp else 0
            b = prev[i]
            c = prev[i - bpp] if i >= bpp else 0
            pp = a + b - c
            pa, pb, pc = abs(pp - a), abs(pp - b), abs(pp - c)
            pr = a if (pa <= pb and pa <= pc) else (b if pb <= pc else c)
            line[i] = (line[i] + pr) & 255
    for x in range(0, stride, bpp):
        if line[x] or (bpp > 2 and (line[x + 1] or line[x + 2])):
            nz += 1
    prev = line
total = w * h
pct = (100.0 * nz / total) if total else 0.0
print(f"capture: {w}x{h} non-black-pixels={nz}/{total} ({pct:.1f}%) "
      f"({'BLANK - output really is black' if nz == 0 else 'has content'})")
PYEOF
    fi

    # Physical-screen cross-check. This is the only evidence that does not come
    # through the compositor, so a failure to run must be visible: it was silently
    # skipped via `|| true` for weeks, which is why an all-black compositor output
    # went unconfirmed against the real display.
    if command -v idevicescreenshot >/dev/null 2>&1 && command -v idevice_id >/dev/null 2>&1; then
        if [ -n "$(idevice_id -l 2>/dev/null)" ]; then
            idevicescreenshot "$outdir/device.png" >/dev/null 2>&1 \
                && echo "copied $outdir/device.png" \
                || echo "WARN: idevicescreenshot failed (USB device present) - no physical cross-check"
        elif [ -n "$(idevice_id -n -l 2>/dev/null)" ]; then
            idevicescreenshot -n "$outdir/device.png" >/dev/null 2>&1 \
                && echo "copied $outdir/device.png" \
                || echo "WARN: idevicescreenshot -n failed (network device) - no physical cross-check"
        else
            echo "WARN: no paired device for idevicescreenshot - no physical cross-check"
        fi
    else
        echo "WARN: idevicescreenshot/idevice_id not installed - no physical cross-check"
    fi

    collect_files "$outdir" "$slot" >/dev/null
    echo "done: $outdir"
}

cmd_collect() {
    local slot="" outarg=""
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --slot) slot="$(sanitize_slot "${2:-}")"; shift 2 ;;
            --slot=*) slot="$(sanitize_slot "${1#--slot=}")"; shift ;;
            --help|-h) usage; exit 0 ;;
            --*) die "unknown collect option: $1" ;;
            *) outarg="$1"; shift ;;
        esac
    done
    local outdir
    outdir="$(make_outdir "$outarg")" || exit 1
    echo "artifact dir: $outdir"
    collect_files "$outdir" "$slot"
    echo "done: $outdir"
}

cmd_push() {
    [ "$#" -ge 1 ] && [ "$#" -le 2 ] || die "push needs LOCAL and optional REMOTE"
    local local_path="$1"
    local remote_path="${2:-$TMP_REMOTE/$(basename "$local_path")}"

    [ -f "$local_path" ] || die "push source is not a regular file: $local_path"
    case "$remote_path" in
        "$TMP_REMOTE"/*) ;;
        *) die "push destination must be beneath $TMP_REMOTE: $remote_path" ;;
    esac
    case "$remote_path" in
        *..*|*[!A-Za-z0-9_./-]*) die "unsafe push destination: $remote_path" ;;
    esac

    scp_ "$local_path" "root@$IP:$remote_path" || exit $?
    ssh_ test -f "$remote_path" || die "device did not retain pushed file: $remote_path"
    echo "pushed $local_path -> $remote_path"
}

cmd_logs() {
    local pattern="${1:-}"
    if [ -n "$pattern" ]; then
        remote "for f in /var/jb/tmp/iosc.log /var/jb/tmp/kde-plasma.log /var/jb/tmp/gnome-shell.log /var/jb/tmp/kgx.log /var/jb/tmp/mutter.log /var/jb/tmp/xios-touch.log; do [ -r \"\$f\" ] && { echo \"== \$f\"; grep -i -- $(printf '%q' "$pattern") \"\$f\" | tail -n 80; }; done"
    else
        remote 'for f in /var/jb/tmp/iosc.log /var/jb/tmp/kde-plasma.log /var/jb/tmp/gnome-shell.log /var/jb/tmp/kgx.log /var/jb/tmp/mutter.log /var/jb/tmp/xios-touch.log; do [ -r "$f" ] && { echo "== $f"; tail -n 80 "$f"; }; done'
    fi
}

cmd_exec() {
    [ "$#" -gt 0 ] || die "exec needs a command"
    remote "$*"
}

cmd="${1:-}"
[ -n "$cmd" ] || { usage; exit 2; }
shift || true

case "$cmd" in
    doctor)     cmd_doctor "$@" ;;
    status)     cmd_status "$@" ;;
    session)    cmd_session "$@" ;;
    app)        cmd_app "$@" ;;
    foreground) cmd_foreground "$@" ;;
    input)      cmd_input "$@" ;;
    shot)       cmd_shot "$@" ;;
    collect)    cmd_collect "$@" ;;
    push)       cmd_push "$@" ;;
    logs)       cmd_logs "$@" ;;
    exec)       cmd_exec "$@" ;;
    help|-h|--help) usage ;;
    *) die "unknown command: $cmd" ;;
esac
