#!/usr/bin/env bash
# Host-side KDE Plasma smoke helper for Xios.
#
# Wraps bin/xios-device so KDE Desktop/Nano/Mobile checks use the same launch,
# foreground, input, screenshot, and collection flow every time.
set -u

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
X11_ROOT="$(cd "$HERE/.." && pwd)"
XIOS_DEVICE="$X11_ROOT/bin/xios-device"

FLAVOR="mobile"
START_SESSION=1
DRAWER=0
APP=""
LAUNCHER=""
LAUNCHER_QUERY=""
LAUNCHER_ACTIVATE=0
POINTER_PROBE=0
SLOT=""
OUTDIR=""
WARMUP=8
CURRENT_PRESET=""

usage() {
    cat <<'EOF'
usage: bin/xios-kde-smoke [options] [desktop|mobile|nano]

Starts or attaches to a KDE Plasma session, foregrounds Xios, optionally
performs a Mobile drawer swipe or launches an app, then captures evidence.

Options:
  --no-session      Do not switch sessions; smoke the current device state
  --drawer          For Mobile, inject an upward drawer swipe before capture
  --app NAME        Launch a KDE/Wayland app through xios-session before capture
  --launcher NAME   For Desktop, launch an applet window: kickoff or kicker
  --query TEXT      Type TEXT into the launched Desktop launcher without Enter
  --activate        Press Enter after --query, launching the highlighted result
  --pointer-probe   Inject pointer/touch/pencil probes before capture
  --slot NAME       Run against a named display slot without foregrounding Xios
  --warmup SEC      Delay after session/app actions before capture (default: 8)
  --out DIR         Local artifact directory
  -h, --help        Show this help

Examples:
  bin/xios-kde-smoke mobile --drawer
  bin/xios-kde-smoke desktop --app systemsettings
  bin/xios-kde-smoke desktop --launcher kickoff --query kwrite --activate
  bin/xios-kde-smoke --no-session --out /tmp/kde-current mobile
EOF
}

die() {
    echo "xios-kde-smoke: $*" >&2
    exit 1
}

valid_number() {
    case "$1" in
        ""|*[!0-9]*) return 1 ;;
        *) return 0 ;;
    esac
}

stamp() {
    date '+%Y%m%d-%H%M%S'
}

session_for_flavor() {
    case "$1" in
        desktop|kde|plasma|kde-desktop|plasma-desktop) printf '%s\n' kde-desktop ;;
        mobile|phone|kde-mobile|plasma-mobile) printf '%s\n' kde-mobile ;;
        nano|kde-nano|plasma-nano) printf '%s\n' kde-nano ;;
        *) return 1 ;;
    esac
}

make_outdir() {
    if [ -n "$OUTDIR" ]; then
        mkdir -p "$OUTDIR" || exit 1
        (cd "$OUTDIR" && pwd)
    else
        local root="${XIOS_ARTIFACT_ROOT:-$X11_ROOT/artifacts/device-runs}"
        local d="$root/kde-${FLAVOR}-smoke-$(stamp)"
        mkdir -p "$d" || exit 1
        printf '%s\n' "$d"
    fi
}

run_logged() {
    local name="$1"
    shift
    echo "==> $*" | tee -a "$LOG"
    "$@" >"$OUT/$name.log" 2>&1
    local rc=$?
    sed -n '1,160p' "$OUT/$name.log" >>"$LOG"
    echo >>"$LOG"
    return "$rc"
}

device_json_dim() {
    local key="$1"
    local json="/var/jb/tmp/xios.json"
    [ -z "$SLOT" ] || json="/var/jb/tmp/xios-$SLOT.json"
    "$XIOS_DEVICE" exec "sed -n 's/.*\"$key\":[[:space:]]*\\([0-9][0-9]*\\).*/\\1/p' $json | head -1" 2>/dev/null | tail -1
}

iosc_input_args() {
    if [ -n "$SLOT" ]; then
        printf '%s\n' --socket "/var/jb/tmp/iosc-$SLOT-input.sock"
    else
        printf '%s\n' --iosc
    fi
}

iosc_input_array() {
    if [ -n "$SLOT" ]; then
        input_args=(--socket "/var/jb/tmp/iosc-$SLOT-input.sock")
    else
        input_args=(--iosc)
    fi
}

mobile_drawer_swipe() {
    local w h x y1 y2
    w="$(device_json_dim width)"
    h="$(device_json_dim height)"
    valid_number "$w" || w=2160
    valid_number "$h" || h=2880
    x=$((w / 2))
    y1=$((h * 84 / 100))
    y2=$((h * 28 / 100))
    local input_args=()
    iosc_input_array
    run_logged input-drawer "$XIOS_DEVICE" input "${input_args[@]}" drag "$x" "$y1" "$x" "$y2"
}

input_text_chars() {
    local text="$1"
    local i ch hex input_args=()
    iosc_input_array
    LC_CTYPE=C
    for ((i = 0; i < ${#text}; i++)); do
        ch="${text:i:1}"
        printf -v hex '0x%02x' "'$ch"
        run_logged "input-key-$i" "$XIOS_DEVICE" input "${input_args[@]}" key "$hex" || return 1
    done
}

desktop_pointer_probe() {
    local w h x y x2 y2
    [ "$FLAVOR" = desktop ] || die "--pointer-probe is only valid for desktop"
    w="$(device_json_dim width)"
    h="$(device_json_dim height)"
    valid_number "$w" || w=2160
    valid_number "$h" || h=2880
    x=$((w / 2))
    y=$((h * 72 / 100))
    x2=$((x + w / 12))
    y2=$((y - h / 10))
    local input_args=()
    iosc_input_array
    run_logged input-pointer-click "$XIOS_DEVICE" input "${input_args[@]}" click "$x" "$y" || true
    run_logged input-touch "$XIOS_DEVICE" input "${input_args[@]}" touch "$x" "$y" || true
    run_logged input-pencil "$XIOS_DEVICE" input "${input_args[@]}" pencil "$x" "$y" "$x2" "$y2" || true
}

desktop_launcher_smoke() {
    local applet="$1"
    local plugin=""
    [ "$FLAVOR" = desktop ] || die "--launcher is only valid for desktop"
    case "$applet" in
        kickoff|org.kde.plasma.kickoff) plugin=org.kde.plasma.kickoff ;;
        kicker|org.kde.plasma.kicker)   plugin=org.kde.plasma.kicker ;;
        *) die "unknown launcher applet: $applet" ;;
    esac

    local app_args=()
    [ -z "$SLOT" ] || app_args=(--slot "$SLOT")
    run_logged launcher-app "$XIOS_DEVICE" app "${app_args[@]}" "/var/jb/Applications/KDE/plasmawindowed.app/plasmawindowed $plugin" || true
    sleep 2
    local shot_args=()
    [ -z "$SLOT" ] || shot_args=(--slot "$SLOT")
    run_logged launcher-open-shot "$XIOS_DEVICE" shot "${shot_args[@]}" "$OUT/launcher-open" || true

    if [ -n "$LAUNCHER_QUERY" ]; then
        input_text_chars "$LAUNCHER_QUERY" || true
        sleep 2
        run_logged launcher-query-shot "$XIOS_DEVICE" shot "${shot_args[@]}" "$OUT/launcher-query" || true
        if [ "$LAUNCHER_ACTIVATE" = 1 ]; then
            local input_args=()
            iosc_input_array
            run_logged launcher-activate "$XIOS_DEVICE" input "${input_args[@]}" key 0xff0d || true
            sleep "$WARMUP"
            run_logged launcher-activate-shot "$XIOS_DEVICE" shot "${shot_args[@]}" "$OUT/launcher-activate" || true
        fi
    fi
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --no-session)
            START_SESSION=0; shift ;;
        --drawer)
            DRAWER=1; shift ;;
        --app)
            APP="${2:-}"; [ -n "$APP" ] || die "--app needs a name"; shift 2 ;;
        --launcher)
            LAUNCHER="${2:-}"; [ -n "$LAUNCHER" ] || die "--launcher needs kickoff or kicker"; shift 2 ;;
        --query)
            LAUNCHER_QUERY="${2:-}"; [ -n "$LAUNCHER_QUERY" ] || die "--query needs text"; shift 2 ;;
        --activate)
            LAUNCHER_ACTIVATE=1; shift ;;
        --pointer-probe)
            POINTER_PROBE=1; shift ;;
        --slot)
            SLOT="${2:-}"; [ -n "$SLOT" ] || die "--slot needs a name"; shift 2 ;;
        --slot=*)
            SLOT="${1#--slot=}"; [ -n "$SLOT" ] || die "--slot needs a name"; shift ;;
        --warmup)
            WARMUP="${2:-}"; valid_number "$WARMUP" || die "--warmup needs an integer"; shift 2 ;;
        --out)
            OUTDIR="${2:-}"; [ -n "$OUTDIR" ] || die "--out needs a directory"; shift 2 ;;
        -h|--help)
            usage; exit 0 ;;
        --*)
            die "unknown option: $1" ;;
        *)
            FLAVOR="$1"; shift ;;
    esac
done

PRESET="$(session_for_flavor "$FLAVOR")" || die "unknown KDE flavor: $FLAVOR"
case "$PRESET" in
    kde-desktop) FLAVOR=desktop ;;
    kde-mobile) FLAVOR=mobile ;;
    kde-nano) FLAVOR=nano ;;
esac
[ -z "$LAUNCHER_QUERY" ] || [ -n "$LAUNCHER" ] || die "--query requires --launcher"
[ "$LAUNCHER_ACTIVATE" = 0 ] || [ -n "$LAUNCHER" ] || die "--activate requires --launcher"

[ -x "$XIOS_DEVICE" ] || die "missing helper: $XIOS_DEVICE"

OUT="$(make_outdir)"
LOG="$OUT/kde-smoke.log"

{
    echo "artifact dir: $OUT"
    echo "flavor: $FLAVOR"
    echo "preset: $PRESET"
    echo "start_session: $START_SESSION"
    echo "drawer: $DRAWER"
    echo "app: ${APP:-}"
    echo "launcher: ${LAUNCHER:-}"
    echo "launcher_query: ${LAUNCHER_QUERY:-}"
    echo "launcher_activate: $LAUNCHER_ACTIVATE"
    echo "pointer_probe: $POINTER_PROBE"
    echo "slot: ${SLOT:-}"
    echo "warmup: $WARMUP"
    echo
} >"$LOG"

status_args=()
[ -z "$SLOT" ] || status_args=(--slot "$SLOT")
run_logged status-before "$XIOS_DEVICE" status "${status_args[@]}" || true
CURRENT_PRESET="$(sed -n 's/.*"preset":"\([^"]*\)".*/\1/p' "$OUT/status-before.log" | head -1)"
if [ -n "$CURRENT_PRESET" ]; then
    echo "current_preset: $CURRENT_PRESET" | tee -a "$LOG"
fi

if [ "$START_SESSION" = 1 ]; then
    session_args=()
    [ -z "$SLOT" ] || session_args=(--slot "$SLOT")
    run_logged session "$XIOS_DEVICE" session "${session_args[@]}" "$PRESET" || true
elif [ -n "$CURRENT_PRESET" ] && [ "$CURRENT_PRESET" != "$PRESET" ]; then
    echo "WARN: --no-session requested $PRESET but device reports $CURRENT_PRESET" | tee -a "$LOG"
fi

if [ -z "$SLOT" ]; then
    run_logged foreground "$XIOS_DEVICE" foreground || true
else
    echo "==> slot $SLOT: skipping foreground" | tee -a "$LOG"
fi

if [ -n "$APP" ]; then
    app_args=()
    [ -z "$SLOT" ] || app_args=(--slot "$SLOT")
    run_logged app "$XIOS_DEVICE" app "${app_args[@]}" "$APP" || true
fi

if [ "$DRAWER" = 1 ]; then
    [ "$FLAVOR" = mobile ] || die "--drawer is only valid for mobile"
    if [ "$START_SESSION" = 0 ] && [ -n "$CURRENT_PRESET" ] && [ "$CURRENT_PRESET" != kde-mobile ]; then
        die "--drawer with --no-session requires current preset kde-mobile (got $CURRENT_PRESET)"
    fi
    mobile_drawer_swipe || true
fi

if [ "$POINTER_PROBE" = 1 ]; then
    desktop_pointer_probe || true
fi

if [ -n "$LAUNCHER" ]; then
    desktop_launcher_smoke "$LAUNCHER" || true
fi

if [ "$WARMUP" -gt 0 ]; then
    echo "==> warmup ${WARMUP}s" | tee -a "$LOG"
    sleep "$WARMUP"
fi

run_logged package-state "$XIOS_DEVICE" exec \
    "dpkg-query -W iosc xios-session kwin plasma-workspace plasma-desktop plasma-mobile plasma-nano 2>/dev/null || true" || true

shot_args=()
[ -z "$SLOT" ] || shot_args=(--slot "$SLOT")
run_logged shot "$XIOS_DEVICE" shot "${shot_args[@]}" "$OUT" || true

cat >"$OUT/summary.txt" <<EOF
KDE smoke
flavor=$FLAVOR
preset=$PRESET
current_preset=${CURRENT_PRESET:-unknown}
artifact_dir=$OUT
drawer=$DRAWER
app=${APP:-}
launcher=${LAUNCHER:-}
launcher_query=${LAUNCHER_QUERY:-}
launcher_activate=$LAUNCHER_ACTIVATE
pointer_probe=$POINTER_PROBE
slot=${SLOT:-}

Key files:
- kde-smoke.log
- status-before.log
- session.log
- foreground.log
- package-state.log
- shot.log
- launcher-open/, launcher-query/, launcher-activate/ when --launcher is used
- compositor.png/device.png if capture succeeded
- collected /var/jb/tmp logs and status files
EOF

echo "artifact dir: $OUT"
echo "summary: $OUT/summary.txt"
